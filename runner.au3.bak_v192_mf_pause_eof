Func ExecuteCompiledCommand($line, $idx)

    Local $compiled = ""
    If IsArray($gCompiledLines) And $idx >= 1 And $idx <= UBound($gCompiledLines) - 1 Then $compiled = $gCompiledLines[$idx]

    ExecuteCompiledText($compiled, $line)

EndFunc

Func ExecuteCompiledText($compiled, $rawLine)

    $compiled = StringStripWS($compiled, 3)
    If $compiled = "" Then
        ExecuteCommand($rawLine)
        Return
    EndIf

    Local $ok = Execute($compiled)
    If @error Then
        GUICtrlSetData($status, "CompileExecErr")
        ExecuteCommand($rawLine)
    EndIf

EndFunc

Func HR_RunAnchor($startPos, $endPos, $repeat, $delaySeconds)

    Local $delayMs = Number($delaySeconds) * 1000
    If $delayMs > 0 Then SafeSleep($delayMs)

EndFunc
Func HR_RunMSP($cmd, $xVal, $yVal, $btn, $repeat, $delaySeconds)

    Local $x = 0
    Local $y = 0
    Local $mspStep = _MspStepNumber($cmd)

    If $mspStep = 1 Then
        If $mspBaseFromMSM Then
            $x = $mspBaseX + Number($xVal)
            $y = $mspBaseY + Number($yVal)
        ElseIf $mspSkipNextBase And $mspReanchorActive Then
            $mspSkipNextBase = False
            Return
        Else
            $mspBaseX = Number($xVal)
            $mspBaseY = Number($yVal)
            $mspBaseSet = True
            $x = $mspBaseX
            $y = $mspBaseY
        EndIf
    ElseIf $mspStep > 1 Then
        If Not $mspBaseSet Then Return
        $x = $mspBaseX + Number($xVal)
        $y = $mspBaseY + Number($yVal)
    Else
        Return
    EndIf

    _DoMouseAction($x, $y, $btn, Number($repeat))

    Local $delayMs = Number($delaySeconds) * 1000
    If $delayMs > 0 Then SafeSleep($delayMs)

EndFunc
Func HR_RunMSM($cmd, $xVal, $yVal, $repeat, $delaySeconds)

    Local $mx = 0
    Local $my = 0
    Local $msmStep = _MspStepNumber($cmd)
    Local $r = Number($repeat)
    If $r < 1 Then $r = 1
    Local $delayMs = Number($delaySeconds) * 1000

    If $msmStep = 1 Then
        If $mspSkipNextBase And $mspReanchorActive Then
            $mspSkipNextBase = False
            $mspBaseFromMSM = True
            Return
        EndIf

        $mspBaseX = Number($xVal)
        $mspBaseY = Number($yVal)
        $mspBaseSet = True
        $mspBaseFromMSM = True
        $mx = $mspBaseX
        $my = $mspBaseY
    ElseIf $msmStep > 1 Then
        If Not $mspBaseSet Then Return
        $mx = $mspBaseX + Number($xVal)
        $my = $mspBaseY + Number($yVal)
    Else
        Return
    EndIf

    For $i = 1 To $r
        MouseMove($mx, $my, 0)
        If $i < $r And $delayMs > 0 Then
            If Not SafeSleep($delayMs) Then Return
        EndIf
    Next

EndFunc
Func HR_RunDrag($startPos, $endPos, $btn, $repeat, $delaySeconds)

    If StringInStr($startPos, "~") < 1 Or StringInStr($endPos, "~") < 1 Then Return

    Local $startPair = StringSplit($startPos, "~")
    Local $endPair = StringSplit($endPos, "~")
    If $startPair[0] < 2 Or $endPair[0] < 2 Then Return

    Local $r = Number($repeat)
    If $r < 1 Then $r = 1
    Local $delayMs = Number($delaySeconds) * 1000

    For $i = 1 To $r
        MouseClickDrag(_MouseButtonName($btn), Number($startPair[1]), Number($startPair[2]), Number($endPair[1]), Number($endPair[2]), 0)
        If $i < $r And $delayMs > 0 Then
            If Not SafeSleep($delayMs) Then Return
        EndIf
    Next

EndFunc
Func HR_RunMouseAction($x, $y, $btn, $repeat)

