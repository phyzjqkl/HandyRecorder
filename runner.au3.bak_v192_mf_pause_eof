Func ToggleRun()

    If $running Or $runPaused Then
        StopRun()
    ElseIf HR_CurrentRunMode() = "MF" Then
        StartManualFlowStep()
    Else
        StartRun()
    EndIf

EndFunc

Func StartRun($manualNext = False)

    If $runPaused Then Return

    $taskRunMode = False
    ReDim $taskRunList[1]
    $taskRunPos = 0
    $runSelectNextAfterFinish = $manualNext

    $gMFStepReady = False

    If HR_CurrentRunMode() = "A" Then
        If Not TaskBuildRunList($taskRunList) Then Return
        $taskRunMode = True
        $taskRunPos = 1
        If Not _SelectTaskRunEntry($taskRunList[$taskRunPos]) Then Return
    Else
        Local $selectedRecord = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
        If $selectedRecord <> "" Then
            If Not SelectRecordByName($selectedRecord) Then Return
        ElseIf $currentFile = "" Or Not FileExists($currentFile) Then
            Return
        EndIf
    EndIf

    $running = True

    GUICtrlSetData($btnStart, "Stop")
    GUICtrlSetData($status, "Running")

    $runLoaded = False
    $runIndex = 1
    $runPaused = False
    $runPauseRequested = False
    $runFocusPauseRequested = False
    $runPauseContinueRequested = False
    $runPausedIndex = 0
    $manualFocusWait = False
    $manualFocusWasDown = False
    $gPatchSavedPrompt = False

    $mspBaseSet = False
    $mspBaseX = 0
    $mspBaseY = 0
    $mspBaseFromMSM = False
    $mspReanchorActive = False
    $mspSkipNextBase = False
    $dragDownActive = False
    $dragDownButton = "L"
    $dragStartX = 0
    $dragStartY = 0

EndFunc

Func StopRun()

    $running = False
    $runPaused = False
    $runPauseRequested = False
    $runFocusPauseRequested = False
    $runPauseContinueRequested = False
    $runPausedIndex = 0
    $manualFocusWait = False
    $manualFocusWasDown = False
    $gPatchSavedPrompt = False
    $gMFStartIndex = 0
    $taskRunMode = False
    ReDim $taskRunList[1]
    $taskRunPos = 0
    $runSelectNextAfterFinish = False
    $mspBaseSet = False
    $mspBaseFromMSM = False
    $mspReanchorActive = False
    $mspSkipNextBase = False

    GUICtrlSetData($btnStart, "Start")

    If $recording Then
        GUICtrlSetData($status, "Recording")
    Else
        GUICtrlSetData($status, "Idle")
    EndIf

EndFunc

Func TogglePlaybackPause()

    If $recording Then
        TogglePauseRecord()
        Return
    EndIf

    If $runPaused Then
        ContinuePausedRun()
        Return
    EndIf

    If $running Then
        PauseRunningFlow()
    EndIf

EndFunc

Func PauseRunningFlow()

    If Not $running Then Return

    $running = False
    $runPaused = True
    $runPauseRequested = False
    $runFocusPauseRequested = False
    $runPauseContinueRequested = False
    $manualFocusWait = False
    $manualFocusWasDown = False
    $gPatchSavedPrompt = False

    If $runPausedIndex < 1 Then $runPausedIndex = $runIndex - 1
    If $runPausedIndex < 1 Then $runPausedIndex = 1

    GUICtrlSetData($btnStart, "Stop")
    GUICtrlSetData($status, "Pause")

EndFunc

Func ManualFocusResume()

    If $recording Then
        RecordManualFocusResume()
        Return
    EndIf

    If Not $runPaused Then Return
    If Not _PausedAtIndefinitePauseCommand() Then Return

    _MarkPausedLineManualFocus()
    $manualFocusWait = True
    $manualFocusWasDown = (_IsPressed("01") Or _IsPressed("11"))
    GUICtrlSetData($status, "Ctrl+Click target")

EndFunc

Func RunActiveCommand()

    If $running Then Return

    If $recording Then
        DeleteSelectedCommandForRecord()
        Return
    EndIf

    If $runPaused Then
        ContinuePausedRun()
        Return
    EndIf

    If HR_CurrentRunMode() = "MF" Then
        StartManualFlowStep()
        Return
    EndIf

    If Not _ValidateCurrentFileResolution() Then Return

    Local $line = GUICtrlRead($cmbCmd)
    If StringStripWS($line, 3) = "" Then Return

    Local $compiled = VarCompileLine($line, $gLoadedRecordName)
    If $gVarCompileError <> "" Then
        GUICtrlSetData($status, $gVarCompileError)
        Return
    EndIf
    ExecuteCompiledText($compiled, $line)

EndFunc

Func RunActiveCommandAndNext()

    If $running Then Return

    If $recording Then
        Return
    EndIf

    If $runPaused Then
        ContinuePausedRun()
        Return
    EndIf

    If HR_CurrentRunMode() = "MF" Then
        StartManualFlowStep()
        Return
    EndIf

    RunActiveCommand()
    SelectNextCommand()

EndFunc
Func StartManualFlowStep()

    If $running Or $runPaused Then Return
    If Not _ValidateCurrentFileResolution() Then Return

    Local $startIndex = _FindActiveIndex()
    If $startIndex < 1 Then $startIndex = 1

    Local $selectedRecord = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
    If $selectedRecord <> "" Then
        If Not SelectRecordByName($selectedRecord) Then Return
    ElseIf $currentFile = "" Or Not FileExists($currentFile) Then
        Return
    EndIf

    If $startIndex > UBound($gCurrLines) - 1 Then $startIndex = UBound($gCurrLines) - 1
    If $startIndex < 1 Then $startIndex = 1

    $taskRunMode = False
    ReDim $taskRunList[1]
    $taskRunPos = 0
    $runSelectNextAfterFinish = False
    $runLoaded = False
    $gMFStartIndex = $startIndex
    $runIndex = $gMFStartIndex
    $running = True
    $runPaused = False
    $runPauseRequested = False
    $runFocusPauseRequested = False
    $runPauseContinueRequested = False
    $runPausedIndex = 0
    $manualFocusWait = False
    $manualFocusWasDown = False
    $gPatchSavedPrompt = False
    $gMFStepReady = False
    $mspBaseSet = False
    $mspBaseFromMSM = False
    $mspReanchorActive = False
    $mspSkipNextBase = False
    $dragDownActive = False
    GUICtrlSetData($btnStart, "Stop")
    GUICtrlSetData($status, "Running")

EndFunc

Func _FindNextRunnableDisplayIndex($startIndex)

    If $startIndex < 1 Then $startIndex = 1
    For $i = $startIndex To UBound($gCurrLines) - 1
        Local $line = StringStripWS($gCurrLines[$i], 3)
        If $line = "" Then ContinueLoop
        If StringLeft($line, 2) = ";=" Then ContinueLoop
        If Not VarCommandLineEnabled($gLoadedRecordName, $i) Then ContinueLoop
        Return $i
    Next
    Return 0

EndFunc

Func _StopManualFlowAfterStep()

    $running = False
    $runLoaded = False
    $runPauseRequested = False
    $runFocusPauseRequested = False
    $runPauseContinueRequested = False
    $runPausedIndex = 0
    $manualFocusWait = False
    $manualFocusWasDown = False
    $gPatchSavedPrompt = False
    $gMFStepReady = True
    $gMFStartIndex = 0

    Local $nextIndex = _FindNextRunnableDisplayIndex($runIndex)
    If $nextIndex > 0 Then
        $gActiveIndex = $nextIndex
        $gLastVisibleText = $gCurrLines[$gActiveIndex]
        _RenderCommands($gActiveIndex)
        GUICtrlSetData($cmbCmd, $gCurrLines[$gActiveIndex])
    ElseIf _ManualFlowSelectNextVisibleRecord() Then
        $nextIndex = _FindNextRunnableDisplayIndex(1)
        If $nextIndex > 0 Then
            $gActiveIndex = $nextIndex
            $gLastVisibleText = $gCurrLines[$gActiveIndex]
            _RenderCommands($gActiveIndex)
            GUICtrlSetData($cmbCmd, $gCurrLines[$gActiveIndex])
        EndIf
    EndIf

    GUICtrlSetData($btnStart, "Start")
    GUICtrlSetData($status, "Idle")

EndFunc
Func _ManualFlowSelectNextVisibleRecord()

    Local $idx = _FindRecordDisplayIndex(GUICtrlRead($cmbFiles))
    If $idx < 1 Then Return False
    If $idx >= UBound($gFileNames) - 1 Then Return False

    Return SelectRecordLineByIndex($idx + 1)

EndFunc
Func _ValidateCurrentFileResolution()

    If _SkipResolutionCheck() Then Return True
    If Not FileExists($currentFile) Then Return True

    Local $line = StringStripWS(FileReadLine($currentFile, 1), 3)
    If StringLeft($line, 14) <> ";= Resolution " Then Return True

    Local $recorded = StringStripWS(StringTrimLeft($line, 14), 3)
    Local $current = @DesktopWidth & "x" & @DesktopHeight

    If $recorded = "" Or $recorded = $current Then Return True

    _ShowResolutionMismatch($recorded, $current)
    Return False

EndFunc

Func ContinuePausedRun()

    If Not $runPaused Then Return

    $running = True
    $runPaused = False
    $runPauseRequested = False
    $runFocusPauseRequested = False
    $runPauseContinueRequested = True
    $runPausedIndex = 0
    $manualFocusWait = False
    $manualFocusWasDown = False
    $gPatchSavedPrompt = False
    $gMFStepReady = False

    GUICtrlSetData($btnStart, "Stop")
    GUICtrlSetData($status, "Running")

EndFunc

Func ManualFocusTick()

    If Not $manualFocusWait Then Return

    If Not $runPaused Then
        $manualFocusWait = False
        $manualFocusWasDown = False
        Return
    EndIf

    Local $leftDown = _IsPressed("01")
    Local $ctrlDown = _IsPressed("11")

    If $manualFocusWasDown Then
        If Not $leftDown And Not $ctrlDown Then $manualFocusWasDown = False
        Return
    EndIf

    If Not $leftDown Or Not $ctrlDown Then Return
    If _MouseInsideRecorderUI() Then Return

    While _IsPressed("01")
        Sleep(5)
        Local $msg = GUIGetMsg()
        Switch $msg
            Case $GUI_EVENT_CLOSE
                Exit
            Case $btnStart
                StopRun()
                Return
        EndSwitch
    WEnd

    ContinuePausedRun()

EndFunc
Func RunNextCommand()

    If Not $running Then Return

    If Not $runLoaded Then

        _FileReadToArray($currentFile, $runLines)

        If @error Then
            StopRun()
            Return
        EndIf

        ; Keep Commands synchronized without re-opening the file during playback.
        LoadCommandsFromArray($runLines)
        If $gVarCompileError <> "" Then
            StopRun()
            GUICtrlSetData($status, $gVarCompileError)
            Return
        EndIf

        If Not _ValidateRunResolution() Then Return

        $runLoaded = True
        If HR_CurrentRunMode() = "MF" And $gMFStartIndex > 0 Then
            $runIndex = $gMFStartIndex
            $gMFStartIndex = 0
        Else
            $runIndex = 1
        EndIf

    EndIf

    If $runIndex > $runLines[0] Then

        If _AdvanceRunTarget() Then Return

        Local $advanceNext = $runSelectNextAfterFinish
        StopRun()
        If $advanceNext Then SelectNextRecordFile()
        Return

    EndIf

    Local $line = StringStripWS($runLines[$runIndex], 3)

    If Not VarCommandLineEnabled($gLoadedRecordName, $runIndex) Then
        $runIndex += 1
        Return
    EndIf

    If $line = "" Then
        $runIndex += 1
        Return
    EndIf

    If StringLeft($line, 2) = ";=" Then
        If _IsOffsetStartComment($line) And _OffsetReanchorEnabled() Then
            $mspBaseSet = False
            $mspBaseFromMSM = False
            If Not _WaitForOffsetReanchor() Then Return
        ElseIf _IsOffsetStartComment($line) Then
            $mspBaseSet = False
            $mspBaseFromMSM = False
        EndIf
        $runIndex += 1
        Return
    EndIf

    $runPausedIndex = $runIndex
    _RenderCommands($runIndex)
    GUICtrlSetData($cmbCmd, $line)
    BlinkActiveRunCommand()

    ExecuteCompiledCommand($line, $runIndex)

    $runIndex += 1

    If $runFocusPauseRequested Then
        $runFocusPauseRequested = False
        $runPauseRequested = False
        $running = False
        $runPaused = True
        $manualFocusWait = True
        $manualFocusWasDown = _IsPressed("01")
        GUICtrlSetData($btnStart, "Stop")
        GUICtrlSetData($status, FocusPauseStatusText())
        Return
    EndIf

    If $runPauseRequested Then
        $runPauseRequested = False
        $running = False
        $runPaused = True
        $manualFocusWait = False
        $manualFocusWasDown = False
        GUICtrlSetData($btnStart, "Stop")
        GUICtrlSetData($status, PauseContinueStatusText())
        Return
    EndIf

    If HR_CurrentRunMode() = "MF" Then
        _StopManualFlowAfterStep()
        Return
    EndIf

    If Not SafeSleep(Number(GUICtrlRead($inputAction)) * 1000) Then Return

EndFunc

Func _ValidateRunResolution()

    If _SkipResolutionCheck() Then Return True

    Local $recorded = ""
    Local $current = @DesktopWidth & "x" & @DesktopHeight

    For $i = 1 To $runLines[0]
        Local $line = StringStripWS($runLines[$i], 3)
        If $line = "" Then ContinueLoop

        If StringLeft($line, 14) = ";= Resolution " Then
            $recorded = StringStripWS(StringTrimLeft($line, 14), 3)
        EndIf

        ExitLoop
    Next

    If $recorded = "" Then Return True
    If $recorded = $current Then Return True

    _ShowResolutionMismatch($recorded, $current)

    Return False

EndFunc

Func _SkipResolutionCheck()

    If $chkSkipRes = 0 Then Return False
    Return GUICtrlRead($chkSkipRes) = $GUI_CHECKED

EndFunc

Func _ShowResolutionMismatch($recorded, $current)

    StopRun()
    GUICtrlSetData($status, "ResMismatch: " & $current)

EndFunc

Func _AdvanceRunTarget()

    Local $fileAuto = (HR_CurrentRunMode() = "A")
    Local $cmdAuto = (GUICtrlRead($chkRepeat) = $GUI_CHECKED)

    If $fileAuto Then
        If _SelectNextTaskRunRecord() Then
            _ResetRunFileState()
            Return True
        EndIf

        If $cmdAuto Then
            If Not SafeSleep(Number(GUICtrlRead($inputRepeat)) * 1000) Then Return True
            If _RestartTaskRunRecords() Then
                _ResetRunFileState()
                Return True
            EndIf
        EndIf

        Return False
    EndIf

    If $cmdAuto Then
        If Not SafeSleep(Number(GUICtrlRead($inputRepeat)) * 1000) Then Return True
        $runIndex = 1
        $mspBaseSet = False
        $dragDownActive = False
        GUICtrlSetData($status, "Running")
        Return True
    EndIf

    Return False

EndFunc

Func _ResetRunFileState()

    $runLoaded = False
    $runIndex = 1
    $runPaused = False
    $runPauseRequested = False
    $runFocusPauseRequested = False
    $runPauseContinueRequested = False
    $runPausedIndex = 0
    $manualFocusWait = False
    $manualFocusWasDown = False
    $mspBaseSet = False
    $dragDownActive = False
    GUICtrlSetData($btnStart, "Stop")
    GUICtrlSetData($status, "Running")

EndFunc

Func _SelectTaskRunEntry($entry)

    $entry = StringStripWS($entry, 3)
    If $entry = "" Then Return False

    If StringInStr($entry, "") > 0 Or StringInStr($entry, "/") > 0 Then
        Local $full = HR_NormalizePath($entry)
        If Not FileExists($full) Then Return False

        $currentFile = $full
        Local $base = $full
        Local $p1 = StringInStr($base, "", 0, -1)
        Local $p2 = StringInStr($base, "/", 0, -1)
        If $p2 > $p1 Then $p1 = $p2
        If $p1 > 0 Then $base = StringMid($base, $p1 + 1)
        If StringRight(StringLower($base), 4) = ".rec" Then $base = StringTrimRight($base, 4)
        $gLoadedRecordName = $base
        GUICtrlSetData($cmbFiles, $full)
        LoadCommands($currentFile)
        Return True
    EndIf

    Return SelectRecordByName($entry)

EndFunc
Func _SelectNextTaskRunRecord()

    If $taskRunMode Then
        $taskRunPos += 1
        If $taskRunPos >= UBound($taskRunList) Then Return False
        Return _SelectTaskRunEntry($taskRunList[$taskRunPos])
    EndIf

    Return SelectNextRecordForRun()

EndFunc

Func _RestartTaskRunRecords()

    If $taskRunMode Then
        $taskRunPos = 1
        If UBound($taskRunList) <= 1 Then Return False
        Return _SelectTaskRunEntry($taskRunList[$taskRunPos])
    EndIf

    Return SelectFirstRecordFile()

EndFunc

Func _OffsetReanchorEnabled()

    If $chkReanchor = 0 Then Return False
    Return GUICtrlRead($chkReanchor) = $GUI_CHECKED

EndFunc

Func _IsOffsetStartComment($line)

    Local $txt = StringStripWS($line, 3)
    Return StringLeft($txt, StringLen(";= Offset Start")) = ";= Offset Start"

EndFunc

Func _WaitForOffsetReanchor()

    $running = False
    $runPaused = True
    GUICtrlSetData($btnStart, "Stop")
    GUICtrlSetData($status, "Click reanchor")

    While 1
        Sleep(10)

        Local $msg = GUIGetMsg()
        Switch $msg
            Case $GUI_EVENT_CLOSE
                Exit
            Case $btnStart
                StopRun()
                Return False
        EndSwitch

        If Not $runPaused Then Return False

        If _IsPressed("01") Then
            If _MouseInsideRecorderUI() Then ContinueLoop

            Local $m = MouseGetPos()
            $mspBaseX = $m[0]
            $mspBaseY = $m[1]
            $mspBaseSet = True
            $mspReanchorActive = True
            $mspSkipNextBase = True

            IniWrite($iniFile, "Settings", "offset_reanchor_date", @YEAR & @MON & @MDAY)

            While _IsPressed("01")
                Sleep(10)
            WEnd

            GUICtrlSetData($status, "Running")
            Return True
        EndIf
    WEnd

EndFunc

Func RunSelectedRecordFile()

    If $running Then StopRun()
    If HR_CurrentRunMode() = "MF" Then
        StartManualFlowStep()
        Return
    EndIf

    Local $recName = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
    StartRun(VarRecordFlag($recName, "next", "0"))

EndFunc
