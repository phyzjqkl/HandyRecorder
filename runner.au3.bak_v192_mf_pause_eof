    For $i = 1 To $r
        MouseMove(Number($x), Number($y), 0)
        MouseDown(_MouseButtonName($btn))
        If $delayMs > 0 Then
            If Not SafeSleep($delayMs) Then Return
        EndIf
    Next

EndFunc

