        "Add Register/create task, L Reload, N New, S Save, D Duplicate, E TSK edit; ^/v/X/B move/delete/block"

EndFunc

Func SaveAppConfig()

    Local $pos = WinGetPos($gui)

    If IsArray($pos) Then
        IniWrite($iniFile, "UI", "x", $pos[0])
        IniWrite($iniFile, "UI", "y", $pos[1])
    EndIf

    IniWrite($iniFile, "Settings", "action_delay", GUICtrlRead($inputAction))
    IniWrite($iniFile, "Settings", "repeat_delay", GUICtrlRead($inputRepeat))

    If GUICtrlRead($chkRepeat) = $GUI_CHECKED Then
        IniWrite($iniFile, "Settings", "auto_repeat", "1")
    Else
        IniWrite($iniFile, "Settings", "auto_repeat", "0")
    EndIf

    If GUICtrlRead($chkFileAuto) = $GUI_CHECKED Then
        IniWrite($iniFile, "Settings", "file_auto", "1")
    Else
        IniWrite($iniFile, "Settings", "file_auto", "0")
    EndIf
    IniWrite($iniFile, "Settings", "run_mode", HR_CurrentRunMode())

    If GUICtrlRead($chkReanchor) = $GUI_CHECKED Then
        IniWrite($iniFile, "Settings", "offset_reanchor", "1")
    Else
        IniWrite($iniFile, "Settings", "offset_reanchor", "0")
    EndIf

EndFunc

Func _CreateDefaultRecord()

    If Not $gTaskActive Then Return
    EnsureActionWorkspace()

    Local $startup = GetStartupRecordName()
    If $startup <> "" Then Return

    $currentFile = RecordPath("record1")
    _AppendFlowName("record1")

    Local $h = FileOpen($currentFile, 2)
    If $h = -1 Then Return

    FileWriteLine($h, ";= Resolution " & @DesktopWidth & "x" & @DesktopHeight)
    FileWriteLine($h, ';=P_P1,"",1,,rem_human_pause')

    FileClose($h)

EndFunc



