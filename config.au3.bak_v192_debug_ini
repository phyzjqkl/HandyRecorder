Func _IniEnsure($section, $key, $default)

    If IniRead($iniFile, $section, $key, "__MISSING__") = "__MISSING__" Then
        IniWrite($iniFile, $section, $key, $default)
    EndIf

EndFunc

Func _IniMigrateDefault($section, $key, $oldDefault, $newDefault)

    If IniRead($iniFile, $section, $key, "") = $oldDefault Then
        IniWrite($iniFile, $section, $key, $newDefault)
    EndIf

EndFunc

Func CfgRead($section, $key, $default)

    Return IniRead($iniFile, $section, $key, $default)

EndFunc

Func CfgReadMultiline($section, $key, $default)

    Return StringReplace(IniRead($iniFile, $section, $key, $default), "\n", @CRLF)

EndFunc

