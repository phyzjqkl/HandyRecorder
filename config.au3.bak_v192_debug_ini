Func HR_InitRuntimePaths($exeDir = "", $taskPath = "")

    If $exeDir = "" Then $exeDir = @ScriptDir

    $gExeDir = HR_NormalizePath($exeDir)
    If $gExeDir = "" Then $gExeDir = @ScriptDir
    $gFlowName = HR_TaskNameFromPath($gExeDir)
    If $gFlowName = "" Then $gFlowName = "handyrecorder"
    $gTaskRegistryFile = $gExeDir & "\" & $gFlowName & ".tasks"
    _HR_MigrateOldTaskRegistry()

    Local $chosenTask = HR_NormalizePath($taskPath)
    If $chosenTask = "" Then $chosenTask = HR_NormalizePath(_HR_CommandLineTaskPath())
    If $chosenTask = "" Then $chosenTask = HR_NormalizePath(HR_TaskRegistryActivePath())

    If $chosenTask = "" And _HR_LooksLikeTaskFolder($gExeDir) Then $chosenTask = $gExeDir

    If $chosenTask = "" Then
        HR_ClearActiveTask()
    Else
        HR_SetActiveTask($chosenTask)
        HR_RegisterTaskPath($appPath, True)
    EndIf

EndFunc

Func HR_ClearActiveTask()

    $gTaskActive = False
    $appPath = ""
    $iniFile = $gExeDir & "\HandyRecorder.ini"

EndFunc

Func HR_SetActiveTask($taskPath)

    $appPath = HR_NormalizePath($taskPath)
    If $appPath = "" Then
        HR_ClearActiveTask()
        Return
    EndIf
    $gTaskActive = True
    DirCreate($appPath)
    $iniFile = $gExeDir & "\HandyRecorder.ini"

EndFunc

Func HR_NormalizePath($path)

    $path = StringStripWS($path, 3)
    If $path = "" Then Return ""

    $path = StringReplace($path, "/", "\")

    While StringLen($path) > 3 And StringRight($path, 1) = "\"
        $path = StringTrimRight($path, 1)
    WEnd

    Return $path

EndFunc

Func HR_TaskNameFromPath($path)

    $path = HR_NormalizePath($path)
    If $path = "" Then Return "newtask"

    Local $pos = StringInStr($path, "\", 0, -1)
    If $pos < 1 Then Return _HR_CleanTaskName($path)

    Local $name = StringMid($path, $pos + 1)
    If $name = "" Then $name = "newtask"
    Return _HR_CleanTaskName($name)

EndFunc

Func HR_SetTaskRegistryFile($file)

    $file = HR_NormalizePath($file)
    If $file = "" Then Return False
    If Not FileExists($file) Then Return False
    If StringRight(StringLower($file), 6) <> ".tasks" Then Return False

    $gTaskRegistryFile = $file

    Local $pos = StringInStr($file, "\", 0, -1)
    Local $base = $file
    If $pos > 0 Then $base = StringMid($file, $pos + 1)
    If StringRight(StringLower($base), 6) = ".tasks" Then $base = StringTrimRight($base, 6)

    $gFlowName = _HR_CleanTaskName($base)
    If $gFlowName = "" Then $gFlowName = "handyrecorder"

    Return True

EndFunc
Func HR_TaskRegistryPath()

    If $gTaskRegistryFile = "" Then
        If $gFlowName = "" Then $gFlowName = HR_TaskNameFromPath($gExeDir)
        If $gFlowName = "" Then $gFlowName = "handyrecorder"
        $gTaskRegistryFile = $gExeDir & "\" & $gFlowName & ".tasks"
    EndIf
    Return $gTaskRegistryFile

EndFunc

Func HR_TaskRegistryActivePath()

    Local $names[1]
    Local $paths[1]
    Local $activePath = ""
    Local $count = _HR_TaskRegistryRead($names, $paths, $activePath)

    If $activePath <> "" Then Return $activePath
    If $count > 0 Then Return $paths[1]

    Return ""

EndFunc

Func HR_RegisterTaskPath($taskPath, $makeActive = True)

    $taskPath = HR_NormalizePath($taskPath)
    If $taskPath = "" Then Return False

    DirCreate($taskPath)

    Local $taskName = HR_TaskNameFromPath($taskPath)
    If $taskName = "" Then Return False

    Local $names[1]
    Local $paths[1]
    Local $activePath = ""
    Local $count = _HR_TaskRegistryRead($names, $paths, $activePath)
    Local $found = False

    For $i = 1 To $count
        If StringLower(HR_NormalizePath($paths[$i])) = StringLower($taskPath) Then
            $names[$i] = $taskName
            $paths[$i] = $taskPath
            $found = True
            ExitLoop
        EndIf
    Next

    If Not $found Then
        $count += 1
        ReDim $names[$count + 1]
        ReDim $paths[$count + 1]
        $names[$count] = $taskName
        $paths[$count] = $taskPath
    EndIf

    If $makeActive Then
        $activePath = $taskPath
    ElseIf $activePath = "" And $count > 0 Then
        $activePath = $paths[1]
    EndIf

    Return _HR_TaskRegistryWrite($names, $paths, $activePath)

EndFunc

Func HR_TaskRegistryLoad(ByRef $names, ByRef $paths)

    Local $activePath = ""
    Return _HR_TaskRegistryRead($names, $paths, $activePath)

EndFunc

Func HR_TaskPathFromNewTaskChoice($choice)

    $choice = HR_NormalizePath($choice)
    If $choice = "" Then Return ""

    If StringLower(StringRight($choice, 4)) = ".tsk" Then
        $choice = StringTrimRight($choice, 4)
    EndIf

    Return $choice

EndFunc

Func _HR_TaskRegistryRead(ByRef $names, ByRef $paths, ByRef $activePath)

    ReDim $names[1]
    ReDim $paths[1]
    $activePath = ""

    Local $file = HR_TaskRegistryPath()
    If Not FileExists($file) Then Return 0

    Local $h = FileOpen($file, 0)
    If $h = -1 Then Return 0

    Local $count = 0
    While 1
        Local $line = FileReadLine($h)
        If @error Then ExitLoop

        $line = StringStripWS($line, 3)
        If $line = "" Then ContinueLoop

        If StringLeft($line, 10) = ";= active|" Then
            $activePath = HR_NormalizePath(StringMid($line, 11))
            ContinueLoop
        EndIf

        If StringLeft($line, 2) = ";=" Then ContinueLoop

        Local $taskName = ""
        Local $taskPath = ""
        Local $sep = StringInStr($line, "|")

        If $sep > 0 Then
            $taskName = StringStripWS(StringLeft($line, $sep - 1), 3)
            $taskPath = HR_NormalizePath(StringMid($line, $sep + 1))
        Else
            $taskPath = HR_NormalizePath($line)
            $taskName = HR_TaskNameFromPath($taskPath)
        EndIf

        If $taskPath = "" Then ContinueLoop
        If $taskName = "" Then $taskName = HR_TaskNameFromPath($taskPath)
        If $taskName = "" Then ContinueLoop

        $count += 1
        ReDim $names[$count + 1]
        ReDim $paths[$count + 1]
        $names[$count] = _HR_CleanTaskName($taskName)
        $paths[$count] = $taskPath
    WEnd

    FileClose($h)
    Return $count

EndFunc

Func _HR_TaskRegistryWrite(ByRef $names, ByRef $paths, $activePath)

    Local $file = HR_TaskRegistryPath()
    Local $h = FileOpen($file, 2)
    If $h = -1 Then Return False

    FileWriteLine($h, ";= HandyRecorder task registry")
    If $activePath <> "" Then FileWriteLine($h, ";= active|" & HR_NormalizePath($activePath))

    For $i = 1 To UBound($names) - 1
        Local $name = _HR_CleanTaskName($names[$i])
        Local $path = HR_NormalizePath($paths[$i])
        If $name = "" Or $path = "" Then ContinueLoop
        FileWriteLine($h, $name & "|" & $path)
    Next

    FileClose($h)
    Return True

EndFunc

Func _HR_MigrateOldTaskRegistry()

    Local $newFile = HR_TaskRegistryPath()
    If FileExists($newFile) Then Return

    Local $oldFile = $gExeDir & "\HandyRecorder.tasks.ini"
    If Not FileExists($oldFile) Then Return

    Local $names[1]
    Local $paths[1]
    Local $count = 0
    Local $activePath = HR_NormalizePath(IniRead($oldFile, "State", "active_path", ""))
    Local $sections = IniReadSectionNames($oldFile)
    If Not IsArray($sections) Then Return

    For $i = 1 To $sections[0]
        Local $sec = $sections[$i]
        If StringLeft($sec, 5) <> "Task." Then ContinueLoop

        Local $path = HR_NormalizePath(IniRead($oldFile, $sec, "path", ""))
        If $path = "" Then ContinueLoop

        Local $name = IniRead($oldFile, $sec, "name", "")
        If $name = "" Then $name = HR_TaskNameFromPath($path)

        $count += 1
        ReDim $names[$count + 1]
        ReDim $paths[$count + 1]
        $names[$count] = $name
        $paths[$count] = $path
    Next

    If $count > 0 Then _HR_TaskRegistryWrite($names, $paths, $activePath)

EndFunc

Func HR_UniqueChildPath($parentPath, $name)

    $parentPath = HR_NormalizePath($parentPath)
    If $parentPath = "" Then $parentPath = $gExeDir

    $name = _HR_CleanTaskName($name)
    If $name = "" Then $name = "newtask"

    Local $base = $parentPath & "\" & $name
    If Not FileExists($base) Then Return $base

    For $i = 1 To 999
        Local $candidate = $base & "_" & $i
        If Not FileExists($candidate) Then Return $candidate
    Next

    Return $base & "_" & @YEAR & @MON & @MDAY & "_" & @HOUR & @MIN & @SEC

EndFunc

Func _HR_CommandLineTaskPath()

    If Not IsArray($CmdLine) Then Return ""

    For $i = 1 To $CmdLine[0]
        Local $arg = $CmdLine[$i]
        Local $lower = StringLower($arg)

        If $lower = "/task" Or $lower = "-task" Then
            If $i < $CmdLine[0] Then Return $CmdLine[$i + 1]
        EndIf

        If StringLeft($lower, 6) = "/task=" Then Return StringMid($arg, 7)
        If StringLeft($lower, 6) = "-task=" Then Return StringMid($arg, 7)
    Next

    Return ""

EndFunc

Func _HR_LooksLikeTaskFolder($path)

    $path = HR_NormalizePath($path)
    If $path = "" Then Return False

    Local $taskName = HR_TaskNameFromPath($path)
    If FileExists($path & "\micracts") Then Return True
    If FileExists($path & "\" & $taskName & ".tsk") Then Return True
    Return False

EndFunc

Func _HR_CleanTaskName($name)

    $name = StringStripWS($name, 3)
    $name = StringRegExpReplace($name, '[\\/:*?"<>|]', "_")
    $name = StringRegExpReplace($name, "\s+", "_")
    Return $name

EndFunc

Func InitConfig()

    If $appPath = "" Then HR_InitRuntimePaths()
    $iniFile = $gExeDir & "\HandyRecorder.ini"

    If Not FileExists($iniFile) Then
        CreateDefaultIni()
    Else
        EnsureDefaultIniValues()
    EndIf

EndFunc

Func HR_NormalizeRunMode($mode, $legacyFileAuto = "")

    $mode = StringUpper(StringStripWS($mode, 3))
    Switch $mode
        Case "M", "MF", "A"
            Return $mode
    EndSwitch

    If StringStripWS($legacyFileAuto, 3) = "1" Then Return "A"
    Return "M"

EndFunc

Func HR_RunModeDisplay($mode)

    $mode = HR_NormalizeRunMode($mode)
    Switch $mode
        Case "A"
            Return "Auto"
        Case "MF"
            Return "ManFlow"
        Case Else
            Return "Man"
    EndSwitch

EndFunc
Func HR_NextRunMode($mode)

    $mode = HR_NormalizeRunMode($mode)
    Switch $mode
        Case "M"
            Return "MF"
        Case "MF"
            Return "A"
    EndSwitch
    Return "M"

EndFunc

Func HR_CurrentRunMode()

    If IsDeclared("gRunMode") Then Return HR_NormalizeRunMode(Eval("gRunMode"))
    Return HR_NormalizeRunMode(CfgRead("Settings", "run_mode", ""), CfgRead("Settings", "file_auto", "0"))

EndFunc
