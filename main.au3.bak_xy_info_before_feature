Func TaskEditor_LoadBrowserList($kind)

    Local $ctrl = $gTaskRecList
    Local $dir = $gTaskRecDir
    Local $pattern = "*.rec"
    If $kind = "blk" Then
        $ctrl = $gTaskBlkList
        $dir = $gTaskBlkDir
        $pattern = "*.blk"
    EndIf

    If $ctrl = 0 Then Return
    If $dir = "" Or Not FileExists($dir) Then
        GUICtrlSetData($ctrl, "|", "")
        Return
    EndIf

    Local $files = _FileListToArray($dir, $pattern, 1)
    Local $data = ""
    If Not @error Then
        For $i = 1 To $files[0]
            Local $show = $files[$i]
            If $kind = "rec" And StringRight(StringLower($show), 4) = ".rec" Then $show = StringTrimRight($show, 4)
            If $data = "" Then
                $data = $show
            Else
                $data &= "|" & $show
            EndIf
        Next
    EndIf

    GUICtrlSetData($ctrl, "|" & $data, "")

EndFunc

Func TaskEditor_ChooseBrowserFolder($kind)

    Local $start = $gTaskRecDir
    If $kind = "blk" Then $start = $gTaskBlkDir
    If $start = "" Then $start = $appPath

    Local $dir = FileSelectFolder("Select " & $kind & " folder", "", 2, $start)
    If @error Or $dir = "" Then Return

    If $kind = "blk" Then
        $gTaskBlkDir = $dir
    Else
        $gTaskRecDir = $dir
    EndIf
    TaskEditor_LoadBrowserList($kind)

EndFunc

Func TaskEditor_LoadBrowserSelection($kind)

    Local $entry = TaskEditor_SelectedBrowserEntry($kind)
