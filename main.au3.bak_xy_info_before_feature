Func TaskEditor_LoadBrowsers()

    If $gTaskRecDir = "" Then $gTaskRecDir = $gMicractsDir
    If $gTaskBlkDir = "" Then $gTaskBlkDir = $gBlkDir
    TaskEditor_LoadBrowserList("rec")
    TaskEditor_LoadBrowserList("blk")

