    $gReviewW = $w
    $gReviewH = $h
    $gReviewZoom = Review_ZoomRatio()
    $gReviewSliderValue = Int($gReviewZoom)
    If $gReviewSliderValue < 1 Then $gReviewSliderValue = 1
    If $gReviewSliderValue > 4 Then $gReviewSliderValue = 4
    $gReviewDispW = Int($w * $gReviewZoom)
    $gReviewDispH = Int($h * $gReviewZoom)
    If $gReviewDispW < 1 Then $gReviewDispW = 1
    If $gReviewDispH < 1 Then $gReviewDispH = 1
    $gReviewRectL = 0
    $gReviewRectT = 0
    $gReviewRectR = $w - 1
    $gReviewRectB = $h - 1
    Review_LoadScreenRectFromLine()

    Local $pos = Review_TargetPos()
    Local $winW = $gReviewDispW
    If $winW < $gReviewMinW Then $winW = $gReviewMinW

    If $gReviewGui <> 0 Then GUIDelete($gReviewGui)

    Review_RenderImage(True)

    $gReviewGui = GUICreate("Review", $winW, $gReviewSliderH + $gReviewDispH + $gReviewEditH, $pos[0], $pos[1], BitOR($WS_POPUP, $WS_BORDER), $WS_EX_TOOLWINDOW, $gui)
    $gReviewAnchorCrop = GUICtrlCreateRadio("", 4, 5, 18, 18)
    $gReviewSlider = GUICtrlCreateSlider(24, 0, $winW - 24, $gReviewSliderH, $TBS_AUTOTICKS)
    GUICtrlSetLimit($gReviewSlider, 4, 1)
    GUICtrlSetData($gReviewSlider, $gReviewSliderValue)
    $gReviewPic = GUICtrlCreatePic($gReviewOverlayFile, 0, $gReviewSliderH, $gReviewDispW, $gReviewDispH)
    $gReviewEditText = GUICtrlRead($cmbCmd)
    $gReviewEdit = GUICtrlCreateEdit($gReviewEditText, 0, $gReviewSliderH + $gReviewDispH, $winW, $gReviewEditH, BitOR($ES_MULTILINE, $ES_AUTOVSCROLL, $WS_VSCROLL))
    If $recording Then GUICtrlSetState($gReviewEdit, $GUI_DISABLE)
    WinSetOnTop($gReviewGui, "", 1)
    GUISetState(@SW_SHOW, $gReviewGui)
    $gReviewVisible = True

EndFunc

Func Review_Close()

    If $gReviewGui <> 0 Then GUIDelete($gReviewGui)

    $gReviewGui = 0
    $gReviewPic = 0
    $gReviewEdit = 0
    $gReviewSlider = 0
    $gReviewAnchorCrop = 0
    $gReviewVisible = False
    $gReviewFile = ""
    $gReviewLine = ""
    $gReviewEditText = ""
    $gReviewDrag = False

EndFunc

Func Review_Poll()

    If GUICtrlRead($chkReview) <> $GUI_CHECKED Then Return
    If Not $gReviewVisible Then Return

    Review_AttachToMain()
    Review_SyncZoomSlider()
    Review_SyncEditRem()

    Local $leftDown = _IsPressed("01")
    If $gReviewW < 1 Or $gReviewH < 1 Then
        If Not $leftDown Then $gReviewDrag = False
        Return
    EndIf

    Local $m = MouseGetPos()
    Local $pos = WinGetPos($gReviewGui)
    If Not IsArray($pos) Then Return

    Local $rawX = $m[0] - $pos[0]
    Local $rawY = $m[1] - $pos[1]
    Local $imageY = $rawY - $gReviewSliderH
    Local $insideImage = ($rawX >= 0 And $imageY >= 0 And $rawX < $gReviewDispW And $imageY < $gReviewDispH)

    If Not $insideImage And Not $gReviewDrag Then
        If Not $leftDown Then $gReviewDrag = False
        Return
    EndIf

    Local $x = Review_DisplayToImageX($rawX)
    Local $y = Review_DisplayToImageY($imageY)

    If $leftDown And Not $gReviewDrag Then
        If Not $insideImage Then Return
        $gReviewDrag = True
        $gReviewStartX = $x
        $gReviewStartY = $y
        Review_SetRect($gReviewStartX, $gReviewStartY, $x, $y)
        Review_RenderImage(True)
        Return
    EndIf

    If $leftDown And $gReviewDrag Then
        Review_SetRect($gReviewStartX, $gReviewStartY, $x, $y)
        Review_RenderImage(True)
        Return
    EndIf

    If Not $leftDown And $gReviewDrag Then
        $gReviewDrag = False
        Review_SetRect($gReviewStartX, $gReviewStartY, $x, $y)
        Review_CommitCrop()
        Return
    EndIf

EndFunc

Func Review_Clamp($value, $minValue, $maxValue)

    If $value < $minValue Then Return $minValue
    If $value > $maxValue Then Return $maxValue
    Return $value

EndFunc

Func Review_ZoomRatio()

    Local $ratio = Number(CfgRead("Review", "zoom_ratio", "2"))
    If $ratio < 1 Then $ratio = 1
    If $ratio > 4 Then $ratio = 4
    Return $ratio

EndFunc

Func Review_DisplayToImageX($x)

    Local $imgX = Int($x / $gReviewZoom)
    Return Review_Clamp($imgX, 0, $gReviewW - 1)

EndFunc

Func Review_DisplayToImageY($y)

    Local $imgY = Int($y / $gReviewZoom)
    Return Review_Clamp($imgY, 0, $gReviewH - 1)

EndFunc

Func Review_TargetPos()

    Local $out[2]
    $out[0] = 200
    $out[1] = 200

    Local $pos = WinGetPos($gui)
    If IsArray($pos) Then
        $out[0] = $pos[0] + $pos[2]
        $out[1] = $pos[1]
    EndIf

    Return $out

EndFunc

Func Review_AttachToMain()

    If $gReviewGui = 0 Then Return

    Local $target = Review_TargetPos()
    Local $pos = WinGetPos($gReviewGui)
    If Not IsArray($pos) Then Return

    If $pos[0] <> $target[0] Or $pos[1] <> $target[1] Then
        WinMove($gReviewGui, "", $target[0], $target[1])
    EndIf

EndFunc

Func Review_SyncEditRem()

    If $recording Then Return
    If $gReviewEdit = 0 Then Return

    Local $txt = GUICtrlRead($gReviewEdit)
    If $txt = $gReviewEditText Then Return
    $txt = TaskTrimRight($txt)
    If StringStripWS($txt, 3) = "" Then Return

    If $gActiveIndex >= 1 And $gActiveIndex <= UBound($gCurrLines) - 1 Then
        $gReviewSyncing = True
        $gCurrLines[$gActiveIndex] = $txt
        $gLastVisibleText = $txt
        _RenderCommands($gActiveIndex)
        $gReviewSyncing = False
    EndIf

    $gReviewLine = $txt
    $gReviewEditText = $txt

EndFunc

Func Review_SyncZoomSlider()

    If $gReviewSlider = 0 Then Return
    If $gReviewW < 1 Or $gReviewH < 1 Then Return

    Local $value = Int(GUICtrlRead($gReviewSlider))
    If $value < 1 Then $value = 1
    If $value > 4 Then $value = 4
    If $value = $gReviewSliderValue Then Return

    $gReviewSliderValue = $value
    $gReviewZoom = $value
    IniWrite($iniFile, "Review", "zoom_ratio", $value)

    Review_ApplyZoomLayout()

EndFunc

Func Review_ApplyZoomLayout()

    If $gReviewGui = 0 Then Return
    If $gReviewW < 1 Or $gReviewH < 1 Then Return

    $gReviewDispW = Int($gReviewW * $gReviewZoom)
    $gReviewDispH = Int($gReviewH * $gReviewZoom)
    If $gReviewDispW < 1 Then $gReviewDispW = 1
    If $gReviewDispH < 1 Then $gReviewDispH = 1

    Local $winW = $gReviewDispW
    If $winW < $gReviewMinW Then $winW = $gReviewMinW

    Local $pos = WinGetPos($gReviewGui)
    If IsArray($pos) Then
        WinMove($gReviewGui, "", $pos[0], $pos[1], $winW, $gReviewSliderH + $gReviewDispH + $gReviewEditH)
    EndIf

    If $gReviewAnchorCrop <> 0 Then GUICtrlSetPos($gReviewAnchorCrop, 4, 5, 18, 18)
    If $gReviewSlider <> 0 Then GUICtrlSetPos($gReviewSlider, 24, 0, $winW - 24, $gReviewSliderH)
    If $gReviewPic <> 0 Then GUICtrlSetPos($gReviewPic, 0, $gReviewSliderH, $gReviewDispW, $gReviewDispH)
    If $gReviewEdit <> 0 Then GUICtrlSetPos($gReviewEdit, 0, $gReviewSliderH + $gReviewDispH, $winW, $gReviewEditH)

    Review_RenderImage(True)

EndFunc

Func Review_SetRect($x1, $y1, $x2, $y2)

    $gReviewRectL = $x1
    $gReviewRectR = $x2
    If $gReviewRectL > $gReviewRectR Then
        $gReviewRectL = $x2
        $gReviewRectR = $x1
    EndIf

    $gReviewRectT = $y1
    $gReviewRectB = $y2
    If $gReviewRectT > $gReviewRectB Then
        $gReviewRectT = $y2
        $gReviewRectB = $y1
    EndIf

    If $gReviewRectR >= $gReviewW Then $gReviewRectR = $gReviewW - 1
    If $gReviewRectB >= $gReviewH Then $gReviewRectB = $gReviewH - 1
    If $gReviewRectL < 0 Then $gReviewRectL = 0
    If $gReviewRectT < 0 Then $gReviewRectT = 0

EndFunc

Func Review_RenderImage($drawRect)

    If $gReviewFile = "" Then Return

    Local $hImg = _GDIPlus_ImageLoadFromFile($gReviewFile)
    If $hImg = 0 Then Return

    Local $hZoom = _GDIPlus_ImageResize($hImg, $gReviewDispW, $gReviewDispH)
    _GDIPlus_ImageDispose($hImg)
    If $hZoom = 0 Then Return

    If $drawRect Then
        Local $hGraphic = _GDIPlus_ImageGetGraphicsContext($hZoom)
        Local $hPen = _GDIPlus_PenCreate(0xFFFF0000, 1)

        Review_DrawDashedRect($hGraphic, $hPen, _
            Int($gReviewRectL * $gReviewZoom), _
            Int($gReviewRectT * $gReviewZoom), _
            Int(($gReviewRectR + 1) * $gReviewZoom) - 1, _
            Int(($gReviewRectB + 1) * $gReviewZoom) - 1)

        _GDIPlus_PenDispose($hPen)
        _GDIPlus_GraphicsDispose($hGraphic)
    EndIf

    _GDIPlus_ImageSaveToFile($hZoom, $gReviewOverlayFile)
    _GDIPlus_ImageDispose($hZoom)

    If $gReviewPic <> 0 Then GUICtrlSetImage($gReviewPic, $gReviewOverlayFile)

EndFunc

Func Review_RenderOverlay()

    Review_RenderImage(True)

EndFunc

Func Review_DrawDashedRect($hGraphic, $hPen, $l, $t, $r, $b)

    Local $dash = 4
    Local $gap = 3

    For $x = $l To $r Step ($dash + $gap)
        Local $x2 = $x + $dash
        If $x2 > $r Then $x2 = $r
        _GDIPlus_GraphicsDrawLine($hGraphic, $x, $t, $x2, $t, $hPen)
        _GDIPlus_GraphicsDrawLine($hGraphic, $x, $b, $x2, $b, $hPen)
    Next

    For $y = $t To $b Step ($dash + $gap)
        Local $y2 = $y + $dash
        If $y2 > $b Then $y2 = $b
        _GDIPlus_GraphicsDrawLine($hGraphic, $l, $y, $l, $y2, $hPen)
        _GDIPlus_GraphicsDrawLine($hGraphic, $r, $y, $r, $y2, $hPen)
    Next

EndFunc

Func Review_CommitCrop()

    If $gReviewFile = "" Then Return

    Local $w = $gReviewRectR - $gReviewRectL + 1
    Local $h = $gReviewRectB - $gReviewRectT + 1
    If $w < 2 Or $h < 2 Then
        Review_ShowFile($gReviewFile)
        Return
    EndIf

    Local $hImg = _GDIPlus_ImageLoadFromFile($gReviewFile)
    If $hImg = 0 Then Return

    Local $hCrop = _GDIPlus_BitmapCloneArea($hImg, $gReviewRectL, $gReviewRectT, $w, $h, $GDIP_PXF32ARGB)
    _GDIPlus_ImageDispose($hImg)
    If $hCrop = 0 Then Return

    _GDIPlus_ImageSaveToFile($hCrop, $gReviewFile)
    _GDIPlus_ImageDispose($hCrop)

    Review_UpdateActiveRemAfterCrop()
    Review_ShowFile($gReviewFile)

EndFunc

Func Review_RecropFromCommandAnchor()

    If $gReviewAnchorCrop <> 0 Then GUICtrlSetState($gReviewAnchorCrop, $GUI_UNCHECKED)

    Review_SyncZoomSlider()

    Local $line = GUICtrlRead($cmbCmd)
    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return

    If $gReviewFile = "" Then $gReviewFile = Review_FileFromCommand($line)
    If $gReviewFile = "" Then Return

    Local $anchor = Review_CommandMousePoint($line)
    If Not $anchor[0] Then
        GUICtrlSetData($status, "No anchor")
        Return
    EndIf

    Local $ratio = Int($gReviewSliderValue)
    If $ratio < 1 Then $ratio = 1
    If $ratio > 4 Then $ratio = 4

    Local $baseW = Number(CfgRead("AutoComment", "crop_w", "80"))
    Local $baseH = Number(CfgRead("AutoComment", "crop_h", "40"))
    If $baseW < 2 Then $baseW = 80
    If $baseH < 2 Then $baseH = 40

    Local $w = Int($baseW * $ratio)
    Local $h = Int($baseH * $ratio)
    If $w < 2 Then $w = 2
    If $h < 2 Then $h = 2

    Local $left = $anchor[1] - Int($w / 2)
    Local $top = $anchor[2] - Int($h / 2)
    Local $right = $left + $w - 1
    Local $bottom = $top + $h - 1

    If $left < 0 Then
        $right -= $left
        $left = 0
    EndIf
    If $top < 0 Then
        $bottom -= $top
        $top = 0
    EndIf
    If $right >= @DesktopWidth Then
        Local $shiftX = $right - @DesktopWidth + 1
        $left -= $shiftX
        $right -= $shiftX
    EndIf
    If $bottom >= @DesktopHeight Then
        Local $shiftY = $bottom - @DesktopHeight + 1
        $top -= $shiftY
        $bottom -= $shiftY
    EndIf
    If $left < 0 Then $left = 0
    If $top < 0 Then $top = 0
    If $right < $left Then $right = $left
    If $bottom < $top Then $bottom = $top

    Review_ApplyScreenRecrop($left, $top, $right, $bottom)

EndFunc

Func Review_ApplyScreenRecrop($left, $top, $right, $bottom)

    Local $line = GUICtrlRead($cmbCmd)
    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return

    Local $label = Review_IdxLabelFromRem($rem)
    If $label = "" Then Return
    Local $parts = StringSplit($label, "_")
    If $parts[0] < 1 Then Return

    Local $anchor = Review_CommandMousePoint($line)
    If Not $anchor[0] Then Return

    Local $baseCount = Review_BaseLabelPartCount($parts)
    If $baseCount < 1 Then Return

    Local $newLabel = ""
    For $i = 1 To $baseCount
        If $i = 1 Then
            $newLabel = $parts[$i]
        Else
            $newLabel &= "_" & $parts[$i]
        EndIf
    Next

    Local $dx1 = $left - $anchor[1]
    Local $dx2 = $right - $anchor[1]
    Local $dy1 = $top - $anchor[2]
    Local $dy2 = $bottom - $anchor[2]
    $newLabel &= "_x" & $dx1 & "~" & $dx2 & "_y" & $dy1 & "~" & $dy2

    Local $oldFile = $gReviewFile
    Local $newFile = $appPath & "\index\" & $newLabel & ".png"

    _CaptureCropRect($newFile, $left, $top, $right, $bottom)
    If $newFile <> $oldFile And FileExists($oldFile) Then FileDelete($oldFile)

    Local $newLine = Review_ReplaceIdxLabelInCommand($line, $newLabel)
    If $gActiveIndex >= 1 And $gActiveIndex <= UBound($gCurrLines) - 1 Then
        $gReviewSyncing = True
        $gCurrLines[$gActiveIndex] = $newLine
        $gLastVisibleText = $newLine
        _RenderCommands($gActiveIndex)
        $gReviewSyncing = False
    EndIf

    $gReviewLine = $newLine
    $gReviewEditText = $newLine
    If $gReviewEdit <> 0 Then GUICtrlSetData($gReviewEdit, $gReviewEditText)
    $gReviewScreenL = $left
    $gReviewScreenT = $top
    $gReviewScreenR = $right
    $gReviewScreenB = $bottom
    $gReviewFile = $newFile

    $gReviewZoom = 1
    $gReviewSliderValue = 1
    IniWrite($iniFile, "Review", "zoom_ratio", "1")

    Review_ShowFile($newFile)

EndFunc

Func Review_LoadScreenRectFromLine()

    $gReviewScreenL = 0
    $gReviewScreenT = 0
    $gReviewScreenR = $gReviewW - 1
    $gReviewScreenB = $gReviewH - 1

    Local $line = GUICtrlRead($cmbCmd)
    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return

    Local $label = Review_IdxLabelFromRem($rem)
    If $label = "" Then Return
    Local $parts = StringSplit($label, "_")
    If $parts[0] < 4 Then Return

    Local $anchor = Review_CommandMousePoint($line)
    Local $xyIdx = Review_XYTokenIndex($parts)
    Local $cropIdx = Review_CropTokenIndex($parts)

    If $xyIdx > 0 And $anchor[0] Then
        Local $xPair = StringSplit(StringTrimLeft($parts[$xyIdx], 1), "~")
        Local $yPair = StringSplit(StringTrimLeft($parts[$xyIdx + 1], 1), "~")
        If $xPair[0] = 2 And $yPair[0] = 2 Then
            $gReviewScreenL = $anchor[1] + Number($xPair[1])
            $gReviewScreenR = $anchor[1] + Number($xPair[2])
            $gReviewScreenT = $anchor[2] + Number($yPair[1])
            $gReviewScreenB = $anchor[2] + Number($yPair[2])
            Return
        EndIf
    EndIf

    If $cropIdx > 0 And $anchor[0] Then
        Local $p1 = StringSplit($parts[$cropIdx + 1], "~")
        Local $p2 = StringSplit($parts[$cropIdx + 2], "~")
        If $p1[0] = 2 And $p2[0] = 2 Then
            $gReviewScreenL = $anchor[1] + Number($p1[1])
            $gReviewScreenT = $anchor[2] + Number($p1[2])
            $gReviewScreenR = $anchor[1] + Number($p2[1])
            $gReviewScreenB = $anchor[2] + Number($p2[2])
            Return
        EndIf
    EndIf

    Local $left = Number($parts[$parts[0] - 3])
    Local $top = Number($parts[$parts[0] - 2])
    Local $right = Number($parts[$parts[0] - 1])
    Local $bottom = Number($parts[$parts[0]])

    If $right < $left Or $bottom < $top Then Return

    $gReviewScreenL = $left
    $gReviewScreenT = $top
    $gReviewScreenR = $right
    $gReviewScreenB = $bottom

EndFunc

Func Review_UpdateActiveRemAfterCrop()

    Local $line = GUICtrlRead($cmbCmd)
    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return

    Local $label = Review_IdxLabelFromRem($rem)
    If $label = "" Then Return
    Local $parts = StringSplit($label, "_")
    If $parts[0] < 1 Then Return

    Local $newLeft = $gReviewScreenL + $gReviewRectL
    Local $newTop = $gReviewScreenT + $gReviewRectT
    Local $newRight = $gReviewScreenL + $gReviewRectR
    Local $newBottom = $gReviewScreenT + $gReviewRectB
    Local $anchor = Review_CommandMousePoint($line)
    If Not $anchor[0] Then Return

    Local $dx1 = $newLeft - $anchor[1]
    Local $dy1 = $newTop - $anchor[2]
    Local $dx2 = $newRight - $anchor[1]
    Local $dy2 = $newBottom - $anchor[2]

    Local $baseCount = Review_BaseLabelPartCount($parts)
    If $baseCount < 1 Then Return

    Local $newLabel = ""
    For $i = 1 To $baseCount
        If $i = 1 Then
            $newLabel = $parts[$i]
        Else
            $newLabel &= "_" & $parts[$i]
        EndIf
    Next

    If $newLabel = "" Then Return

    $newLabel &= "_x" & $dx1 & "~" & $dx2 & "_y" & $dy1 & "~" & $dy2

    Local $newFile = $appPath & "\index\" & $newLabel & ".png"
    If $newFile <> $gReviewFile Then
        FileMove($gReviewFile, $newFile, 9)
        $gReviewFile = $newFile
    EndIf

    Local $newLine = Review_ReplaceIdxLabelInCommand($line, $newLabel)
    If $gActiveIndex >= 1 And $gActiveIndex <= UBound($gCurrLines) - 1 Then
        $gReviewSyncing = True
        $gCurrLines[$gActiveIndex] = $newLine
        $gLastVisibleText = $newLine
        _RenderCommands($gActiveIndex)
        $gReviewSyncing = False
    EndIf

    $gReviewLine = $newLine
    $gReviewEditText = $newLine
    If $gReviewEdit <> 0 Then GUICtrlSetData($gReviewEdit, $gReviewEditText)
    $gReviewScreenL = $newLeft
    $gReviewScreenT = $newTop
    $gReviewScreenR = $newRight
    $gReviewScreenB = $newBottom

EndFunc

Func Review_CommandMousePoint($line)

    Local $out[3]
    $out[0] = False
    $out[1] = 0
    $out[2] = 0

    Local $p = StringSplit($line, ",")
    If $p[0] < 3 Then Return $out

    Local $cmd = $p[1]

    If StringLeft($cmd, 7) = "Anchor_" Then
        Local $xPair = StringSplit($p[2], "~")
        Local $yPair = StringSplit($p[3], "~")
        If $xPair[0] >= 1 And $yPair[0] >= 1 Then
            $out[0] = True
            $out[1] = Number($xPair[1])
            $out[2] = Number($yPair[1])
        EndIf
        Return $out
    EndIf

    If StringLeft($cmd, 4) = "MSM_" Then
        Local $msmStep = Review_OffsetStepNumber($cmd)

        If $msmStep = 1 Then
            $out[0] = True
            $out[1] = Number($p[2])
            $out[2] = Number($p[3])
            Return $out
        EndIf

        Local $msmBase = Review_OffsetBaseForCurrentLine($cmd)
        If $msmBase[0] Then
            $out[0] = True
            $out[1] = $msmBase[1] + Number($p[2])
            $out[2] = $msmBase[2] + Number($p[3])
            Return $out
        EndIf

        Return $out
    EndIf

    If StringLeft($cmd, 4) = "MSP_" Then
        Local $mspStep = Review_OffsetStepNumber($cmd)
        Local $mspBase = Review_OffsetBaseForCurrentLine($cmd)

        If $mspBase[0] And ($mspStep > 1 Or $mspBase[3]) Then
            $out[0] = True
            $out[1] = $mspBase[1] + Number($p[2])
            $out[2] = $mspBase[2] + Number($p[3])
            Return $out
        EndIf

        $out[0] = True
        $out[1] = Number($p[2])
        $out[2] = Number($p[3])
        Return $out
    EndIf

    If StringLeft($cmd, 2) = "M_" Or StringLeft($cmd, 3) = "MM_" Then
        $out[0] = True
        $out[1] = Number($p[2])
        $out[2] = Number($p[3])
        Return $out
    EndIf

    If StringLeft($cmd, 3) = "MD_" Then
        Local $xPair = StringSplit($p[2], "~")
        Local $yPair = StringSplit($p[3], "~")
        If $xPair[0] >= 1 And $yPair[0] >= 1 Then
            $out[0] = True
            $out[1] = Number($xPair[1])
            $out[2] = Number($yPair[1])
        EndIf
    EndIf

    Return $out

EndFunc

Func Review_OffsetBaseForCurrentLine($cmd)

    Local $out[4]
    $out[0] = False
    $out[1] = 0
    $out[2] = 0
    $out[3] = False

    Local $group = Review_OffsetGroupNumber($cmd)
    If $group < 1 Then Return $out

    Local $startIdx = $gActiveIndex
    If $startIdx < 1 Then $startIdx = UBound($gCurrLines) - 1
    If $startIdx > UBound($gCurrLines) - 1 Then $startIdx = UBound($gCurrLines) - 1

    Local $fallbackFound = False
    Local $fallbackX = 0
    Local $fallbackY = 0

    For $i = $startIdx - 1 To 1 Step -1
        Local $prev = StringStripWS($gCurrLines[$i], 3)
        If StringLeft($prev, StringLen(";= Offset Start")) = ";= Offset Start" Then ExitLoop

        Local $p = StringSplit($prev, ",")
        If $p[0] < 3 Then ContinueLoop

        Local $prevCmd = $p[1]
        If Review_OffsetGroupNumber($prevCmd) <> $group Then ContinueLoop
        If Review_OffsetStepNumber($prevCmd) <> 1 Then ContinueLoop

        If StringLeft($prevCmd, 4) = "MSM_" Then
            $out[0] = True
            $out[1] = Number($p[2])
            $out[2] = Number($p[3])
            $out[3] = True
            Return $out
        EndIf

        If StringLeft($prevCmd, 4) = "MSP_" And Not $fallbackFound Then
            $fallbackFound = True
            $fallbackX = Number($p[2])
            $fallbackY = Number($p[3])
        EndIf
    Next

    If $fallbackFound Then
        $out[0] = True
        $out[1] = $fallbackX
        $out[2] = $fallbackY
    EndIf

    Return $out

EndFunc

Func Review_OffsetGroupNumber($cmd)

    Local $parts = StringSplit($cmd, "_")
    If $parts[0] >= 3 Then Return Number($parts[2])
    Return 0

EndFunc

Func Review_OffsetStepNumber($cmd)

    Local $parts = StringSplit($cmd, "_")
    If $parts[0] >= 3 Then Return Number($parts[3])
    If $parts[0] = 2 Then Return Number($parts[2])
    Return 0

EndFunc

Func Review_CommandCanRecrop($line)

    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return False

    Local $anchor = Review_CommandMousePoint($line)
    Return $anchor[0]

EndFunc

Func Review_CropTokenIndex(ByRef $parts)

    If $parts[0] < 3 Then Return 0

    For $i = 1 To $parts[0] - 2
        If $parts[$i] = "crop" Then
            If StringInStr($parts[$i + 1], "~") > 0 And StringInStr($parts[$i + 2], "~") > 0 Then Return $i
        EndIf
    Next

    Return 0

EndFunc

Func Review_XYTokenIndex(ByRef $parts)

    If $parts[0] < 2 Then Return 0

    For $i = 1 To $parts[0] - 1
        If StringLeft($parts[$i], 1) = "x" And StringLeft($parts[$i + 1], 1) = "y" Then
            If StringInStr($parts[$i], "~") > 0 And StringInStr($parts[$i + 1], "~") > 0 Then Return $i
        EndIf
    Next

    Return 0

EndFunc

Func Review_BaseLabelPartCount(ByRef $parts)

    Local $xyIdx = Review_XYTokenIndex($parts)
    If $xyIdx > 1 Then Return $xyIdx - 1

    Local $cropIdx = Review_CropTokenIndex($parts)
    If $cropIdx > 1 Then Return $cropIdx - 1

    If $parts[0] >= 4 _
        And Review_IsIntegerToken($parts[$parts[0] - 3]) _
        And Review_IsIntegerToken($parts[$parts[0] - 2]) _
        And Review_IsIntegerToken($parts[$parts[0] - 1]) _
        And Review_IsIntegerToken($parts[$parts[0]]) Then

        Return $parts[0] - 4
    EndIf

    Return $parts[0]

EndFunc

Func Review_IsIntegerToken($text)

    If StringRegExp($text, "^-?[0-9]+$") Then Return True
    Return False

EndFunc

Func Review_IdxLabelFromRem($rem)

    If StringLeft($rem, 4) <> "rem_" Then Return ""

    Local $body = StringTrimLeft($rem, 4)
    Local $m = StringRegExp($body, '(idx_[A-Za-z0-9~\-]+(?:_[A-Za-z0-9~\-]+)*)', 1)
    If @error Or Not IsArray($m) Then Return ""
    Return $m[0]

EndFunc

Func Review_ReplaceIdxLabelInCommand($line, $newLabel)

    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return $line

    Local $body = StringTrimLeft($rem, 4)
    If StringRegExp($body, 'idx_[A-Za-z0-9~\-]+(?:_[A-Za-z0-9~\-]+)*') Then
        $body = StringRegExpReplace($body, 'idx_[A-Za-z0-9~\-]+(?:_[A-Za-z0-9~\-]+)*', $newLabel, 1)
    ElseIf $body = "" Then
        $body = $newLabel
    Else
        $body &= ' ' & $newLabel
    EndIf

    Return Review_ReplaceRemInCommand($line, 'rem_' & $body)

EndFunc
Func Review_FileFromCommand($line)

    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return ""

    Local $label = Review_IdxLabelFromRem($rem)
    If $label = "" Then Return ""

    Return $appPath & "\index\" & $label & ".png"

EndFunc

Func Review_RemFromCommand($line)

    Local $p = StringSplit($line, ",")
    If $p[0] < 1 Then Return ""

    Local $remIdx = Review_RemFieldIndex($p[1])
    If $remIdx < 1 Or $p[0] < $remIdx Then Return ""

    Local $rem = ""
    For $i = $remIdx To $p[0]
        If $i = $remIdx Then
            $rem = $p[$i]
        Else
            $rem &= "," & $p[$i]
        EndIf
    Next

    $rem = StringStripWS($rem, 3)

    Return $rem

EndFunc

Func Review_ReplaceRemInCommand($line, $newRem)

    Local $p = StringSplit($line, ",")
    If $p[0] < 2 Then Return $line

    $newRem = Review_NormalizeRemText($newRem)

    Local $remIdx = Review_RemFieldIndex($p[1])
    If $remIdx < 2 Then Return $line

    Local $out = ""
    For $i = 1 To $remIdx - 1
        Local $val = ""
        If $i <= $p[0] Then $val = $p[$i]

        If $i = 1 Then
            $out = $val
        Else
            $out &= "," & $val
        EndIf
    Next

    If $out = "" Then Return $newRem

    Return $out & "," & $newRem

EndFunc

Func Review_RemFieldIndex($cmd)

    If StringLeft($cmd, 2) = "M_" Then Return 7
    If StringLeft($cmd, 4) = "MSP_" Then Return 7
    If StringLeft($cmd, 4) = "MSM_" Then Return 7
    If StringLeft($cmd, 7) = "Anchor_" Then Return 7
    If StringLeft($cmd, 3) = "MD_" Then Return 7
    If StringLeft($cmd, 3) = "MM_" Then Return 7
    If StringLeft($cmd, 2) = "K_" Then Return 5
    If StringLeft($cmd, 2) = "S_" Then Return 5
    If StringLeft($cmd, 3) = "MW_" Then Return 5
    If StringLeft($cmd, 2) = "P_" Then Return 5
    If StringLeft($cmd, 2) = "T_" Then Return 5

    Return 0

EndFunc

Func Review_NormalizeRemText($text)

    $text = StringReplace($text, @CRLF, " ")
    $text = StringReplace($text, @CR, " ")
    $text = StringReplace($text, @LF, " ")
    $text = StringStripWS($text, 3)

    If $text = "" Then $text = "rem_"

    Return $text

EndFunc

Func _MouseInsideReviewWindow()

    If $gReviewGui = 0 Then Return False

    Local $pos = WinGetPos($gReviewGui)
    If Not IsArray($pos) Then Return False

    Local $m = MouseGetPos()

    If $m[0] >= $pos[0] _
        And $m[0] <= ($pos[0] + $pos[2]) _
        And $m[1] >= $pos[1] _
        And $m[1] <= ($pos[1] + $pos[3]) Then

        Return True

    EndIf

    Return False

EndFunc











