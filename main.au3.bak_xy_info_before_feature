Func HR_WM_NCHITTEST($hWnd, $iMsg, $wParam, $lParam)

    Local Const $HTCLIENT = 1
    Local Const $HTCAPTION = 2

    Local $pos = WinGetPos($gui)
    If Not IsArray($pos) Then Return $HTCLIENT

    Local $m = MouseGetPos()
    Local $x = $m[0] - $pos[0]
    Local $y = $m[1] - $pos[1]

    If $y >= 0 And $y <= 20 And $x >= 0 And $x < 184 Then Return $HTCAPTION

    Return $HTCLIENT

EndFunc

