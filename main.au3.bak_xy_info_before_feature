Func TaskEditor_BlockSelected()

    Local $first, $last
    If Not TaskEditor_SelectedRange($first, $last) Then Return

    Local $name = TaskEditor_AskBlockName()
    $name = TaskCleanBlockName($name)
    If $name = "" Then
        GUICtrlSetData($status, "Blk name")
        Return
    EndIf

    Local $blkFile = TaskBlockPath($name)
    If FileExists($blkFile) Then
        GUICtrlSetData($status, "Blk exists")
        Return
    EndIf

    Local $lines[1]
    Local $count = TaskReadLines($lines)
    If $count < 1 Then Return

    Local $h = FileOpen($blkFile, 2)
    If $h = -1 Then Return
    For $i = $first To $last
        FileWriteLine($h, $lines[$i])
    Next
    FileClose($h)

    Local $new[1]
    Local $n = 0
    For $i = 1 To $count
        If $i = $first Then
            $n += 1
            ReDim $new[$n + 1]
            $new[$n] = $name & ".blk"
        EndIf
        If $i >= $first And $i <= $last Then ContinueLoop
        $n += 1
        ReDim $new[$n + 1]
        $new[$n] = $lines[$i]
    Next
    $new[0] = $n

    TaskWriteLines($new)
    TaskEditor_Load()
    TaskEditor_SelectRange($first, $first)
    GUICtrlSetData($gTaskNameInput, "")
    TaskEditor_RefreshSidePanels()
    GUICtrlSetData($status, "Blk made")
    ReloadRecordList()

EndFunc

Func TaskEditor_LoadVariables()

    If $gTaskVarList = 0 Then Return

    If $gEnvFile = "" Or Not FileExists($gEnvFile) Then
        GUICtrlSetData($gTaskVarList, "|", "")
        Return
    EndIf

    Local $lines
    _FileReadToArray($gEnvFile, $lines)
    If @error Then
        GUICtrlSetData($gTaskVarList, "|", "")
        Return
    EndIf

    Local $data = ""
    For $i = 1 To $lines[0]
        Local $line = StringStripWS($lines[$i], 3)
        If $line = "" Then ContinueLoop
        If StringLeft($line, 2) = ";=" Then ContinueLoop
        If StringLeft($line, 1) = ";" Then ContinueLoop
        If StringLeft($line, 1) = "[" Then ContinueLoop
        Local $eq = StringInStr($line, "=")
        If $eq < 2 Then ContinueLoop
        Local $key = StringStripWS(StringLeft($line, $eq - 1), 3)
        Local $val = StringStripWS(StringMid($line, $eq + 1), 3)
        If $key = "" Then ContinueLoop
        Local $show = $key & " = " & $val
        If $data = "" Then
            $data = $show
        Else
            $data &= "|" & $show
        EndIf
    Next

    GUICtrlSetData($gTaskVarList, "|" & $data, "")

EndFunc
