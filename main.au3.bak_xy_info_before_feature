Func Review_ShowFile($file)

    Local $hImg = _GDIPlus_ImageLoadFromFile($file)
    If $hImg = 0 Then Return

    Local $w = _GDIPlus_ImageGetWidth($hImg)
    Local $h = _GDIPlus_ImageGetHeight($hImg)
