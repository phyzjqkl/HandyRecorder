Func StopOrOff()

    If $recording Then
        ToggleRecord()
        Return
    EndIf

    StopRun()

EndFunc

Func StopRecordOnly()

    If $recording Then ToggleRecord()

EndFunc

Func _RegisterHotkey($key, $func)

    $key = StringStripWS($key, 3)
    If $key = "" Then Return

    HotKeySet($key, $func)

    Local $n = UBound($gRegisteredHotkeys)
    ReDim $gRegisteredHotkeys[$n + 1]
    $gRegisteredHotkeys[$n] = $key

EndFunc

Func _ClearRegisteredHotkeys()

    For $i = 1 To UBound($gRegisteredHotkeys) - 1
        If $gRegisteredHotkeys[$i] <> "" Then HotKeySet($gRegisteredHotkeys[$i])
    Next

    ReDim $gRegisteredHotkeys[1]

EndFunc

Func CycleRunMode()

    $gRunMode = HR_NextRunMode($gRunMode)
    GUICtrlSetData($chkFileAuto, HR_RunModeDisplay($gRunMode))
    IniWrite($iniFile, "Settings", "run_mode", $gRunMode)
    If $gRunMode = "A" Then
        IniWrite($iniFile, "Settings", "file_auto", "1")
    Else
        IniWrite($iniFile, "Settings", "file_auto", "0")
    EndIf
    If Not $running And Not $runPaused And Not $recording Then GUICtrlSetData($status, "Idle")

EndFunc
Func ReloadConfigAndRecordList()

    EnsureDefaultIniValues()
    RegisterAppHotkeys()
    TaskRegistry_RefreshCombo($appPath)

    GUICtrlSetData($inputAction, CfgRead("Settings", "action_delay", "0.5"))
    GUICtrlSetData($inputRepeat, CfgRead("Settings", "repeat_delay", "3"))
    $gBlinkEnabled = (CfgRead("UI", "blink_enabled", "1") = "1")
    $gBlinkPauseMs = Number(CfgRead("UI", "blink_pause_ms", "250"))
    $gBlinkButtonMs = Number(CfgRead("UI", "blink_button_ms", "700"))
    If $gBlinkPauseMs < 120 Then $gBlinkPauseMs = 120
    If $gBlinkButtonMs < 300 Then $gBlinkButtonMs = 300

    If Not $recording Then
        If CfgRead("Settings", "auto_repeat", "0") = "1" Then
            GUICtrlSetState($chkRepeat, $GUI_CHECKED)
        Else
            GUICtrlSetState($chkRepeat, $GUI_UNCHECKED)
        EndIf
    EndIf

    $gRunMode = HR_NormalizeRunMode(CfgRead("Settings", "run_mode", ""), CfgRead("Settings", "file_auto", "0"))
    GUICtrlSetData($chkFileAuto, HR_RunModeDisplay($gRunMode))

    Local $reloadReanchor = CfgRead("Settings", "offset_reanchor", "0")
    If CfgRead("Settings", "offset_reanchor_date", "") <> (@YEAR & @MON & @MDAY) Then $reloadReanchor = "1"
    If $reloadReanchor = "1" Then
        GUICtrlSetState($chkReanchor, $GUI_CHECKED)
    Else
        GUICtrlSetState($chkReanchor, $GUI_UNCHECKED)
    EndIf

    If Not $gTaskActive Then
        ReDim $gCurrLines[1]
        $gActiveIndex = 0
        $gLoadedRecordName = ""
        $currentFile = ""
        GUICtrlSetData($cmbFiles, "|", "")
        GUICtrlSetData($cmbCmd, "|", "")
        GUICtrlSetData($status, "NoTask")
        If $gHelpTipVisible Then HR_ShowHelp()
        Return
    EndIf

    ReloadRecordList()
    If $recording Then
        If $offsetMode Then
            GUICtrlSetData($status, "OffsetOn")
        Else
            GUICtrlSetData($status, "Recording")
        EndIf
    ElseIf $running Then
        GUICtrlSetData($status, "Running")
    Else
        GUICtrlSetData($status, "Idle")
    EndIf

    If $gHelpTipVisible Then HR_ShowHelp()

EndFunc

