Func TaskRegistry_LoadTasksFile()

    Local $startDir = $gExeDir
    Local $tasks = FileOpenDialog("Load task list .tasks", $startDir, "Task list (*.tasks)", 1)
    If @error Or $tasks = "" Then Return

    If Not HR_SetTaskRegistryFile($tasks) Then
        GUICtrlSetData($status, "BadTasks")
        Return
    EndIf

    Local $taskPath = HR_TaskRegistryActivePath()
    TaskRegistry_Close()

    If $taskPath <> "" Then
        TaskRegistry_SwitchToPath($taskPath, False)
    Else
        HR_ClearActiveTask()
        TaskRegistry_UpdateTitle()
        TaskRegistry_RefreshCombo("")
        GUICtrlSetData($cmbFiles, "|", "")
        GUICtrlSetData($cmbCmd, "|", "")
        GUICtrlSetData($status, "NoTask")
    EndIf

EndFunc
Func TaskRegistry_AddExisting()

    Local $startDir = $appPath
    If $startDir = "" Then $startDir = $gExeDir

    Local $tsk = FileOpenDialog("Select task .tsk", $startDir, "Task (*.tsk)", 1)
    If @error Or $tsk = "" Then Return

    Local $pos = StringInStr($tsk, "\", 0, -1)
    If $pos < 2 Then Return

    Local $taskPath = StringLeft($tsk, $pos - 1)
    TaskRegistry_Close()
    TaskRegistry_SwitchToPath($taskPath)

EndFunc

Func TaskRegistry_CreateNew()

    Local $choice = FileSaveDialog("New task name", $gExeDir, "Task name (*.*)", 2, "newtask")
    If @error Or $choice = "" Then Return

    Local $basePath = HR_TaskPathFromNewTaskChoice($choice)
    If $basePath = "" Then Return

    Local $sep = StringInStr($basePath, "\", 0, -1)
    If $sep < 2 Then Return

    Local $parent = StringLeft($basePath, $sep - 1)
    Local $name = HR_TaskNameFromPath($basePath)
    If $parent = "" Or $name = "" Then Return

    Local $taskPath = HR_UniqueChildPath($parent, $name)
    TaskRegistry_CreateEmptyTask($taskPath)
    TaskRegistry_Close()
    TaskRegistry_SwitchToPath($taskPath, False)

EndFunc

Func TaskRegistry_CreateEmptyTask($taskPath)

    $taskPath = HR_NormalizePath($taskPath)
    If $taskPath = "" Then Return False

    Local $taskName = HR_TaskNameFromPath($taskPath)
    If $taskName = "" Then $taskName = "newtask"

    DirCreate($taskPath)
    DirCreate($taskPath & "\micracts")
    DirCreate($taskPath & "\index")
    DirCreate($taskPath & "\export")
    DirCreate($taskPath & "\blk")

    Local $tskFile = $taskPath & "\" & $taskName & ".tsk"
    If Not FileExists($tskFile) Then
        Local $h = FileOpen($tskFile, 2)
        If $h <> -1 Then FileClose($h)
    EndIf

    Return True

EndFunc

Func TaskRegistry_RefreshCombo($selectPath = "")

    If $cmbTasks = 0 Then Return

    Local $names[1]
    Local $paths[1]
    Local $count = HR_TaskRegistryLoad($names, $paths)
    Local $data = ""
    Local $selectedName = ""

    If $selectPath = "" Then $selectPath = $appPath
    $selectPath = HR_NormalizePath($selectPath)

    For $i = 1 To $count
        If $data = "" Then
            $data = $names[$i]
        Else
            $data &= "|" & $names[$i]
        EndIf

        If StringLower(HR_NormalizePath($paths[$i])) = StringLower($selectPath) Then $selectedName = $names[$i]
    Next

    GUICtrlSetData($cmbTasks, "|" & $data, $selectedName)

EndFunc

Func TaskRegistry_SwitchSelected()

    Local $name = StringStripWS(GUICtrlRead($cmbTasks), 3)
    If $name = "" Then Return

    Local $names[1]
    Local $paths[1]
    Local $count = HR_TaskRegistryLoad($names, $paths)

    For $i = 1 To $count
        If $names[$i] = $name Then
            TaskRegistry_SwitchToPath($paths[$i])
            Return
        EndIf
    Next

EndFunc

Func TaskRegistry_SwitchToPath($taskPath, $createDefaultRecord = True)

    If $recording Or $running Or $runPaused Then
        GUICtrlSetData($status, "IdleOnly")
        TaskRegistry_RefreshCombo($appPath)
        Return False
    EndIf

    $taskPath = HR_NormalizePath($taskPath)
    If $taskPath = "" Then Return False

    SaveAppConfig()
    Review_Close()
    TaskEditor_Close()

    HR_SetActiveTask($taskPath)
    HR_RegisterTaskPath($appPath, True)
    InitConfig()
    EnsureActionWorkspace()
    If $createDefaultRecord Then _CreateDefaultRecord()
    TaskRegistry_UpdateTitle()
    TaskRegistry_RefreshCombo($appPath)
    If $createDefaultRecord Then
        ReloadConfigAndRecordList()
    Else
        RefreshFiles("")
        GUICtrlSetData($cmbFiles, "")
        GUICtrlSetData($cmbCmd, "|", "")
        $currentFile = ""
        $gLoadedRecordName = ""
    EndIf

    GUICtrlSetData($status, "Idle")
    Return True

EndFunc

