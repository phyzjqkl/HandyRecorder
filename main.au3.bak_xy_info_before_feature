Func VarOpenPopup()

    _SyncActiveFromUI()

    Local $idx = _FindActiveIndex()
    If $idx < 1 Or $idx > UBound($gCurrLines) - 1 Then
        GUICtrlSetData($status, "NoCmd")
        Return
    EndIf

    Local $line = $gCurrLines[$idx]
    If StringStripWS($line, 3) = "" Or StringLeft(StringStripWS($line, 3), 2) = ";=" Then
        GUICtrlSetData($status, "NoCmd")
        Return
    EndIf

    VarBuildCandidates($line, $idx)
    If $gVarCandCount < 1 Then
        GUICtrlSetData($status, "NoVar")
        Return
    EndIf
    Local $pos = WinGetPos($gui)
    Local $x = $pos[0] + $pos[2] + 4
    Local $h = 54 + ($gVarCandCount * 28)
    If $h > 420 Then $h = 420
    Local $y = $pos[1] + $pos[3] - $h
    If $y < 0 Then $y = 0

    Local $vGui = GUICreate("VAR", 270, $h, $x, $y, $WS_POPUPWINDOW, $WS_EX_TOPMOST, $gui)
    Local $btns[$gVarCandCount + 1]
    Local $nameInputs[$gVarCandCount + 1]
    Local $valueInputs[$gVarCandCount + 1]

    GUICtrlCreateLabel("$", 6, 8, 12, 16)
    GUICtrlCreateLabel("Name", 23, 8, 50, 16)
    GUICtrlCreateLabel("Value", 128, 8, 36, 16)
    GUICtrlCreateLabel("Type", 200, 8, 28, 16)


    For $i = 1 To $gVarCandCount
        Local $rowY = 26 + (($i - 1) * 28)
        $btns[$i] = GUICtrlCreateButton("$", 6, $rowY - 1, 14, 22)
        $nameInputs[$i] = GUICtrlCreateInput($gVarCandName[$i], 23, $rowY, 100, 20)
        Local $valueText = $gVarCandV1[$i]
        If $gVarCandV2[$i] <> "" Then $valueText &= "," & $gVarCandV2[$i]
        $valueInputs[$i] = GUICtrlCreateInput($valueText, 128, $rowY, 67, 20)
        GUICtrlCreateLabel(VarShortTypeLabel($gVarCandLabel[$i], $gVarCandType[$i]), 200, $rowY + 4, 26, 16)
    Next

    Local $btnClose = GUICtrlCreateButton("X", 248, $h - 26, 20, 22)

    GUISetState(@SW_SHOW, $vGui)
    While 1
        Local $msgInfo = GUIGetMsg(1)
        Local $msg = $msgInfo[0]
        Local $hWnd = $msgInfo[1]

        If $hWnd = $vGui Then
            If $msg = $GUI_EVENT_CLOSE Or $msg = $btnClose Then ExitLoop

            For $i = 1 To $gVarCandCount
                If $msg = $btns[$i] Then
                    VarCandidateSetValueFromText($i, GUICtrlRead($valueInputs[$i]))
                    If VarPromoteCandidate($idx, $i, GUICtrlRead($nameInputs[$i])) Then ExitLoop 2
                EndIf
            Next
        ElseIf $hWnd = $gui Then
            Switch $msg
                Case $cmbCmd
                    UpdateActiveIndexOnly()
                    Review_UpdateFromActive()
                    GUIDelete($vGui)
                    VarOpenPopup()
                    Return
                Case $cmbFiles
                    Local $f = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
                    If $f <> "" Then
                        $currentFile = RecordPath($f)
                        If FileExists($currentFile) Then
                            $gLoadedRecordName = _CleanRecordName($f)
                            LoadCommands($currentFile)
                            Review_UpdateFromActive()
                        Else
                            GUICtrlSetData($status, "NoFile")
                        EndIf
                    EndIf
                    GUIDelete($vGui)
                    VarOpenPopup()
                    Return
            EndSwitch
        EndIf

        Sleep(20)
    WEnd

    GUIDelete($vGui)
    If HR_DebugMode() Then VarDebugShowCompiled()

EndFunc

Func VarCandidateSetValueFromText($cand, $text)

    $text = StringStripWS($text, 3)
    If $gVarCandType[$cand] = "pair" Or $gVarCandType[$cand] = "pair_field" Then
        Local $p = StringSplit($text, ",")
        If $p[0] >= 2 Then
            $gVarCandV1[$cand] = StringStripWS($p[1], 3)
            $gVarCandV2[$cand] = StringStripWS($p[2], 3)
            Return
        EndIf
    EndIf

    $gVarCandV1[$cand] = $text
    $gVarCandV2[$cand] = ""

EndFunc
Func _VarCandV2Text($i)

    If $gVarCandV2[$i] = "" Then Return ""
    Return "," & $gVarCandV2[$i]

EndFunc

Func VarCandidateIndexFromList($text)

    Local $sp = StringSplit(StringStripWS($text, 3), " ")
    If $sp[0] < 1 Then Return 0
    Local $n = Number($sp[1])
    If $n < 1 Or $n > $gVarCandCount Then Return 0
    Return $n

EndFunc

Func VarShortTypeLabel($label, $type)

    Switch $label
        Case "enable"
            Return "on"
        Case "seconds"
            Return "sec"
        Case "delay"
            Return "sec"
        Case "instruction"
            Return "str"
        Case "text"
            Return "str"
        Case "pos"
            Return "pos"
        Case "start_pos"
            Return "p1"
        Case "end_pos"
            Return "p2"
        Case "repeat"
            Return "n"
    EndSwitch

    Switch $type
        Case "pair", "pair_field"
            Return "pos"
        Case "scalar"
            Return "val"
        Case "enable"
            Return "on"
    EndSwitch

    Return ""

EndFunc

Func VarPauseInstructionDefault($line)

    Local $body = VarPauseRemBody($line)
    If $body = "" Then Return ""

    If StringLeft($body, 5) = "pause" Then $body = StringStripWS(StringTrimLeft($body, 5), 3)
    Local $m = StringRegExp($body, '^<([^<>]+)>$', 1)
    If IsArray($m) And UBound($m) > 0 Then Return $m[0]

    Return $body

EndFunc

Func VarPauseRemBody($line)

    Local $rem = Review_RemFromCommand($line)
    If StringLeft($rem, 4) <> "rem_" Then Return ""
    Return StringTrimLeft($rem, 4)

EndFunc

Func VarPauseValueToRem($line, $value)

    $value = StringStripWS($value, 3)
    Local $cmd = _CsvField($line, 1)

    If StringLeft($cmd, 3) = "P_P" Then
        If $value = "" Then Return "rem_pause"
        If StringLeft($value, 1) = "<" And StringRight($value, 1) = ">" Then Return "rem_pause" & $value
        Return "rem_pause<" & $value & ">"
    EndIf

    If $value = "" Then Return "rem_"
    If StringInStr($value, "<") > 0 And StringInStr($value, ">") > 0 Then Return "rem_" & $value
    Return "rem_<" & $value & ">"

EndFunc
Func VarBuildCandidates($line, $idx)

    $gVarCandCount = 0
    Local $cmd = _CsvField($line, 1)

    VarAddCandidate("enable", "enable_" & $idx, "1", "", 0, 0, "enable")

    If StringLeft($cmd, 2) = "M_" And StringLeft($cmd, 3) <> "MD_" Then
        VarAddCandidate("pos", "pos_" & $idx, _CsvField($line, 2), _CsvField($line, 3), 2, 3, "pair")
        VarAddCandidate("repeat", "repeat_" & $idx, _CsvField($line, 5), "", 5, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 6), "", 6, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 3) = "MM_" Then
        VarAddCandidate("pos", "pos_" & $idx, _CsvField($line, 2), _CsvField($line, 3), 2, 3, "pair")
        VarAddCandidate("repeat", "repeat_" & $idx, _CsvField($line, 5), "", 5, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 6), "", 6, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 4) = "MSP_" Or StringLeft($cmd, 4) = "MSM_" Then
        VarAddCandidate("pos", "pos_" & $idx, _CsvField($line, 2), _CsvField($line, 3), 2, 3, "pair")
        VarAddCandidate("repeat", "repeat_" & $idx, _CsvField($line, 5), "", 5, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 6), "", 6, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 3) = "MD_" Then
        VarAddPairFieldCandidate("start_pos", "start_pos_" & $idx, _CsvField($line, 2), 2)
        VarAddPairFieldCandidate("end_pos", "end_pos_" & $idx, _CsvField($line, 3), 3)
        VarAddCandidate("repeat", "repeat_" & $idx, _CsvField($line, 5), "", 5, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 6), "", 6, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 7) = "Anchor_" Then
        VarAddPairFieldCandidate("start_pos", "start_pos_" & $idx, _CsvField($line, 2), 2)
        VarAddPairFieldCandidate("end_pos", "end_pos_" & $idx, _CsvField($line, 3), 3)
        VarAddCandidate("repeat", "repeat_" & $idx, _CsvField($line, 5), "", 5, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 6), "", 6, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 2) = "K_" Then
        VarAddCandidate("repeat", "repeat_" & $idx, _CsvField($line, 3), "", 3, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 4), "", 4, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 2) = "S_" Then
        VarAddCandidate("text", "text_" & $idx, _CsvField($line, 2), "", 2, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 4), "", 4, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 3) = "MW_" Then
        VarAddCandidate("repeat", "repeat_" & $idx, _CsvField($line, 3), "", 3, 0, "scalar")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 4), "", 4, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 2) = "P_" Then
        VarAddCandidate("instruction", "pause_text_" & $idx, VarPauseInstructionDefault($line), "", 7, 0, "pause_rem")
        VarAddCandidate("delay", "delay_" & $idx, _CsvField($line, 4), "", 4, 0, "scalar")
        Return
    EndIf

    If StringLeft($cmd, 2) = "T_" Then
        VarAddCandidate("seconds", "seconds_" & $idx, _CsvField($line, 2), "", 2, 0, "scalar")
        Return
    EndIf

EndFunc
Func VarAddPairFieldCandidate($label, $name, $fieldValue, $fieldIndex)

    Local $p = StringSplit($fieldValue, "~")
    If $p[0] >= 2 Then
        VarAddCandidate($label, $name, $p[1], $p[2], $fieldIndex, 0, "pair_field")
    Else
        VarAddCandidate($label, $name, $fieldValue, "", $fieldIndex, 0, "scalar")
    EndIf

EndFunc
Func VarAddCandidate($label, $name, $v1, $v2, $field1, $field2, $type)

    If $gVarCandCount >= UBound($gVarCandLabel) - 1 Then Return
    $gVarCandCount += 1
    $gVarCandLabel[$gVarCandCount] = $label
    $gVarCandName[$gVarCandCount] = $name
    $gVarCandV1[$gVarCandCount] = VarUnquote($v1)
    $gVarCandV2[$gVarCandCount] = VarUnquote($v2)
    $gVarCandF1[$gVarCandCount] = $field1
    $gVarCandF2[$gVarCandCount] = $field2
    $gVarCandType[$gVarCandCount] = $type

EndFunc

Func VarPromoteCandidate($idx, $cand, $name)

    $name = StringStripWS($name, 3)
    If StringLeft($name, 1) = "$" Then $name = StringTrimLeft($name, 1)
    If $name = "" Then Return False
    If Not StringRegExp($name, "^[A-Za-z_][A-Za-z0-9_]*$") Then
        GUICtrlSetData($status, "BadVarName")
        Return False
    EndIf

    Local $scope = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
    If $scope = "" Then $scope = $gLoadedRecordName
    If $scope = "" Then Return False

    Local $storeType = $gVarCandType[$cand]
    If $storeType = "pause_rem" Then $storeType = "scalar"
    If Not VarEnvAddVariable($scope, $name, $gVarCandV1[$cand], $gVarCandV2[$cand], $storeType) Then Return False

    Local $line = $gCurrLines[$idx]
    If $gVarCandType[$cand] = "pair" Then
        $line = VarSetCommandField($line, $gVarCandF1[$cand], "$" & $name & "[1]")
        $line = VarSetCommandField($line, $gVarCandF2[$cand], "$" & $name & "[2]")
    ElseIf $gVarCandType[$cand] = "pair_field" Then
        $line = VarSetCommandField($line, $gVarCandF1[$cand], "$" & $name & "[1]~$" & $name & "[2]")
    ElseIf $gVarCandType[$cand] = "pause_rem" Then
        $line = Review_ReplaceRemInCommand($line, VarPauseValueToRem($line, $gVarCandV1[$cand]))
    Else
        $line = VarSetCommandField($line, $gVarCandF1[$cand], "$" & $name)
    EndIf

    $gCurrLines[$idx] = $line
    $gActiveIndex = $idx
    $gLastVisibleText = $line
    VarCompileCommands()
    _RenderCommands($idx)
    SaveCurrentData()
    GUICtrlSetData($status, "VarSaved")
    Return True

EndFunc

Func VarSetCommandField($line, $fieldIndex, $newValue)

    Local $cmd = _CsvField($line, 1)
    Local $count = VarCommandPreRemCount($cmd)
    If $fieldIndex < 1 Or $fieldIndex > $count Then Return $line

    Local $out = ""
    For $i = 1 To $count
        Local $value = _CsvField($line, $i)
        If $i = $fieldIndex Then $value = $newValue
        If $i = 1 Then
            $out = $value
        Else
            $out &= "," & $value
        EndIf
    Next

    Local $rem = _CommandRemTail($line, "")
    If $rem <> "" Then $out &= "," & $rem
    Return $out

EndFunc

Func VarCommandPreRemCount($cmd)

    If StringLeft($cmd, 2) = "M_" Or StringLeft($cmd, 3) = "MM_" Or StringLeft($cmd, 3) = "MD_" Or StringLeft($cmd, 4) = "MSP_" Or StringLeft($cmd, 4) = "MSM_" Or StringLeft($cmd, 7) = "Anchor_" Then Return 6
    Return 4

EndFunc














