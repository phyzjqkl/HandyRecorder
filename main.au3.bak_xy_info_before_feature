EndFunc

Func TaskEditor_InsertBrowserSelection($kind)

    Local $entry = TaskEditor_SelectedBrowserEntry($kind)
    If $entry = "" Then Return
    TaskEditor_InsertLineAfterSelection($entry)

EndFunc

Func TaskEditor_SelectedBrowserEntry($kind)

    Local $ctrl = $gTaskRecList
    Local $dir = $gTaskRecDir
    Local $localDir = $gMicractsDir
    If $kind = "blk" Then
        $ctrl = $gTaskBlkList
        $dir = $gTaskBlkDir
        $localDir = $gBlkDir
    EndIf

    If $ctrl = 0 Then Return ""
    Local $item = StringStripWS(GUICtrlRead($ctrl), 3)
    If $item = "" Then Return ""

    Local $fileName = $item
    If $kind = "rec" And StringRight(StringLower($fileName), 4) <> ".rec" Then $fileName &= ".rec"
    Local $full = $dir & "\" & $fileName

    If StringLower(HR_NormalizePath($dir)) = StringLower(HR_NormalizePath($localDir)) Then
        If $kind = "rec" Then Return _TaskBrowserBaseName($item)
        Return _TaskBrowserBaseName($item) & ".blk"
    EndIf

    Return $full

EndFunc

Func _TaskBrowserBaseName($name)

    Local $base = StringStripWS($name, 3)
    If StringRight(StringLower($base), 4) = ".rec" Then $base = StringTrimRight($base, 4)
    If StringRight(StringLower($base), 4) = ".blk" Then $base = StringTrimRight($base, 4)
    Return $base

EndFunc

Func TaskEditor_InsertLineAfterSelection($entry)

    TaskEditor_SyncLineEdit()
    Local $first, $last
    Local $hasSel = TaskEditor_SelectedRange($first, $last)

    Local $lines[1]
    Local $count = TaskReadLines($lines)
    Local $insertAfter = $count
    If $hasSel Then $insertAfter = $last

    Local $new[1]
    Local $n = 0
    If $count < 1 Then
        ReDim $new[2]
        $new[0] = 1
        $new[1] = $entry
        TaskWriteLines($new)
        TaskEditor_Load()
        TaskEditor_SelectRange(1, 1)
        TaskEditor_LoadSelectedLine()
        GUICtrlSetData($status, "Inserted")
        ReloadRecordList()
        Return
    EndIf

    For $i = 1 To $count
        $n += 1
        ReDim $new[$n + 1]
        $new[$n] = $lines[$i]
        If $i = $insertAfter Then
            $n += 1
            ReDim $new[$n + 1]
            $new[$n] = $entry
        EndIf
    Next
    $new[0] = $n

    TaskWriteLines($new)
    TaskEditor_Load()
    TaskEditor_SelectRange($insertAfter + 1, $insertAfter + 1)
    TaskEditor_LoadSelectedLine()
    GUICtrlSetData($status, "Inserted")
    ReloadRecordList()

EndFunc

Func TaskEditor_DeleteSelected()

    Local $first, $last
    If Not TaskEditor_SelectedRange($first, $last) Then Return

    Local $lines[1]
    Local $count = TaskReadLines($lines)
    If $count < 1 Then Return

    Local $new[1]
    Local $n = 0
    For $i = 1 To $count
        If $i >= $first And $i <= $last Then ContinueLoop
        $n += 1
        ReDim $new[$n + 1]
        $new[$n] = $lines[$i]
    Next
    $new[0] = $n

    TaskWriteLines($new)
    TaskEditor_Load()
    If $n > 0 Then
        If $first > $n Then $first = $n
        TaskEditor_SelectRange($first, $first)
    EndIf
    ReloadRecordList()

EndFunc

Func UpdateBlinkUI()

    If $gBlinkPauseMs < 120 Then $gBlinkPauseMs = 120
    If $gBlinkButtonMs < 300 Then $gBlinkButtonMs = 300

    If Not $gBlinkEnabled Then
        _ResetBlinkUI()
        Return
    EndIf

    Local $paused = ($runPaused Or $gRecordPaused)

    If $paused And TimerDiff($gBlinkPauseTimer) >= $gBlinkPauseMs Then
        $gBlinkPauseOn = Not $gBlinkPauseOn
        $gBlinkPauseTimer = TimerInit()
    EndIf

    If $recording And TimerDiff($gBlinkButtonTimer) >= $gBlinkButtonMs Then
        $gBlinkButtonOn = Not $gBlinkButtonOn
        $gBlinkButtonTimer = TimerInit()
    EndIf

    If $paused Then
        If $gRecordPaused Then
            _BlinkSetStatusText("RecPause F9=Rec")
        ElseIf $manualFocusWait Then
            _BlinkSetStatusText(FocusPauseStatusText())
        ElseIf $gPatchSavedPrompt Then
            _BlinkSetStatusText("Saved F9=Run")
        ElseIf PauseNeedsManualFocusWarning() Then
            _BlinkSetStatusText(FocusPauseStatusText())
        Else
            _BlinkSetStatusText(PauseContinueStatusText())
        EndIf

        If $gBlinkPauseOn Then
            _BlinkSetStatusColor(0xD00000)
        Else
            _BlinkSetStatusColor(0x000000)
        EndIf
    Else
        _BlinkSetStatusColor(0x000000)
    EndIf

    _UpdateBlinkControls()

EndFunc

Func _ResetBlinkUI()

    _BlinkSetStatusColor(0x000000)
    _BlinkSetCommandColor(0x000000)
    _BlinkSetStartText("Start")
    _BlinkSetRecText("Rec")

EndFunc

Func _UpdateBlinkControls()

    If $running Or $runPaused Then
        _BlinkSetStartText("Stop")
    Else
        _BlinkSetStartText("Start")
        _BlinkSetCommandColor(0x000000)
    EndIf

    If $recording Then
        If $gBlinkButtonOn Then
            _BlinkSetRecText("Off")
        Else
            _BlinkSetRecText("")
        EndIf
    Else
        _BlinkSetRecText("Rec")
    EndIf

EndFunc

Func _BlinkSetStatusText($text)

    If $gBlinkLastStatusText = $text And GUICtrlRead($status) = $text Then Return
    GUICtrlSetData($status, $text)
    $gBlinkLastStatusText = $text

EndFunc

