Func SyncSelectedRecordDisplay()

    If $recording Or $running Or $runPaused Then Return
    If $cmbFiles = 0 Then Return

    Local $name = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
    If $name = "" Then Return

    Local $cleanName = _CleanRecordName($name)
    If $cleanName = "" Then Return

    Local $needsLoad = False
    If $gLoadedRecordName <> $cleanName Then $needsLoad = True
    If UBound($gCurrLines) <= 1 Then $needsLoad = True

    If Not $needsLoad Then Return
    If Not FileExists(RecordPath($cleanName)) Then Return

    SelectRecordByName($cleanName)

EndFunc

Func HR_EnableDpiAwareness()

    ; Keep mouse coordinates and screenshot coordinates in the same pixel space
    ; when Windows display scaling is not 100%.
    Local $aRet = DllCall("user32.dll", "bool", "SetProcessDpiAwarenessContext", "ptr", -4)
    If IsArray($aRet) And $aRet[0] Then Return

    $aRet = DllCall("shcore.dll", "long", "SetProcessDpiAwareness", "int", 2)
    If IsArray($aRet) And $aRet[0] = 0 Then Return

    DllCall("user32.dll", "bool", "SetProcessDPIAware")

EndFunc

