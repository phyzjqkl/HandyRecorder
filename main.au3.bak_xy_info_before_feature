Func TaskEditor_Load()

    If $gTaskList = 0 Then Return

    Local $lines[1]
    Local $count = TaskReadLines($lines)
    Local $data = ""

    For $i = 1 To $count
        Local $line = TaskTrimRight($lines[$i])
        If $line = "" Then ContinueLoop
        Local $display = TaskDisplayLine($line)
        If $data = "" Then
            $data = $display
        Else
            $data &= "|" & $display
        EndIf
    Next

    GUICtrlSetData($gTaskList, "|" & $data)
    GUICtrlSetData($gTaskNameInput, "")

EndFunc

Func TaskEditor_LoadSelectedLine()

    If $gTaskList = 0 Or $gTaskNameInput = 0 Then Return
    Local $first, $last
    If Not TaskEditor_SelectedRange($first, $last) Then Return
    If $first <> $last Then Return

    Local $lines[1]
    Local $count = TaskReadLines($lines)
    If $first < 1 Or $first > $count Then Return
    GUICtrlSetData($gTaskNameInput, TaskTrimRight($lines[$first]))

EndFunc

Func TaskEditor_SyncLineEdit()

    If $gTaskList = 0 Or $gTaskNameInput = 0 Then Return False

    Local $first, $last
    If Not TaskEditor_SelectedRange($first, $last) Then Return False
    If $first <> $last Then Return False

    Local $txt = GUICtrlRead($gTaskNameInput)
    $txt = TaskTrimRight($txt)
    If StringStripWS($txt, 3) = "" Then Return False

    Local $lines[1]
    Local $count = TaskReadLines($lines)
    If $first < 1 Or $first > $count Then Return False
    If $lines[$first] = $txt Then Return True

    $lines[$first] = $txt
    TaskWriteLines($lines)
    ReloadRecordList()
    Return True

EndFunc

Func TaskEditor_SelectedRange(ByRef $first, ByRef $last)

    $first = -1
    $last = -1
    If $gTaskList = 0 Then Return False

    Local Const $LB_GETSELCOUNT = 0x0190
    Local Const $LB_GETSELITEMS = 0x0191
    Local Const $LB_GETCURSEL = 0x0188

    Local $selCount = GUICtrlSendMsg($gTaskList, $LB_GETSELCOUNT, 0, 0)
    If $selCount < 1 Then
        Local $cur = GUICtrlSendMsg($gTaskList, $LB_GETCURSEL, 0, 0)
        If $cur < 0 Then Return False
        $first = $cur + 1
        $last = $cur + 1
        Return True
    EndIf

    Local $tItems = DllStructCreate("int[" & $selCount & "]")
    GUICtrlSendMsg($gTaskList, $LB_GETSELITEMS, $selCount, DllStructGetPtr($tItems))

    For $i = 1 To $selCount
        Local $idx = DllStructGetData($tItems, 1, $i) + 1
        If $first = -1 Or $idx < $first Then $first = $idx
        If $last = -1 Or $idx > $last Then $last = $idx
    Next

    If ($last - $first + 1) <> $selCount Then
        GUICtrlSetData($status, "SelBlock")
        Return False
    EndIf

    Return True

EndFunc

Func TaskEditor_SelectRange($first, $last)

    If $gTaskList = 0 Then Return
    If $first < 1 Then $first = 1
    If $last < $first Then $last = $first

    Local Const $LB_SETSEL = 0x0185
    Local Const $LB_SETCURSEL = 0x0186

    GUICtrlSendMsg($gTaskList, $LB_SETSEL, 0, -1)
    For $i = $first To $last
        GUICtrlSendMsg($gTaskList, $LB_SETSEL, 1, $i - 1)
    Next
    GUICtrlSendMsg($gTaskList, $LB_SETCURSEL, $first - 1, 0)

EndFunc

Func TaskEditor_MoveSelected($dir)

    Local $first, $last
    If Not TaskEditor_SelectedRange($first, $last) Then Return

    Local $lines[1]
    Local $count = TaskReadLines($lines)
    If $count < 1 Then Return

    If $dir < 0 Then
        If $first <= 1 Then Return
        Local $before = $lines[$first - 1]
        For $i = $first - 1 To $last - 1
            $lines[$i] = $lines[$i + 1]
        Next
        $lines[$last] = $before
    Else
        If $last >= $count Then Return
        Local $after = $lines[$last + 1]
        For $i = $last + 1 To $first + 1 Step -1
            $lines[$i] = $lines[$i - 1]
        Next
        $lines[$first] = $after
    EndIf

    TaskWriteLines($lines)
    TaskEditor_Load()
    If $dir < 0 Then
        TaskEditor_SelectRange($first - 1, $last - 1)
    Else
        TaskEditor_SelectRange($first + 1, $last + 1)
    EndIf
    ReloadRecordList()

EndFunc

Func TaskEditor_AskBlockName()

