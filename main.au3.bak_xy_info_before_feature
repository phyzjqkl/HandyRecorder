    If $first < 1 Or $first > $count Then Return

    Local $forkName = TaskRecordNameFromLine($lines[$first])
    If $forkName = "" Or Not TaskRecordExists($forkName) Then
        GUICtrlSetData($status, "NoFork")
        Return
    EndIf

    If Not SelectRecordByName($forkName) Then
        GUICtrlSetData($status, "NoFork")
        Return
