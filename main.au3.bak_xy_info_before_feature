Func Review_UpdateFromActive()

    If GUICtrlRead($chkReview) <> $GUI_CHECKED Then Return
    If $gReviewSyncing Then Return

    Local $line = GUICtrlRead($cmbCmd)
    If StringStripWS($line, 3) = "" Then Return
    If $line = $gReviewLine Then Return

    $gReviewLine = $line
    Local $file = Review_FileFromCommand($line)

    If $file = "" Or Not FileExists($file) Then
        Review_ShowTextOnly($line)
        Return
    EndIf

    Review_ShowFile($file)

EndFunc

Func Review_ShowLatestIndex($file)

    If GUICtrlRead($chkReview) <> $GUI_CHECKED Then Return
