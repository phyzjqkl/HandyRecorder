    If StringLeft($cmd, 3) = "M_D" Then Return "HR_RunMouseDown(" & $x & "," & $y & "," & $btn & "," & $repeat & "," & $delay & ")"
    If StringLeft($cmd, 3) = "M_U" Then Return "HR_RunMouseUp(" & $x & "," & $y & "," & $btn & "," & $repeat & "," & $delay & ")"

    Return "HR_RunMouseAction(" & $x & "," & $y & "," & $btn & "," & $repeat & ")"

