Func VarLoadEnv()

    ReDim $gVarArray[0][5]
    ReDim $gVarIndex[0][3]
    ReDim $gCompiledLines[1]
    $gVarCompileError = ""

    If $gEnvFile = "" Or Not FileExists($gEnvFile) Then Return True

    Local $lines
    _FileReadToArray($gEnvFile, $lines)
    If @error Then Return True

    Local $scope = ""

    For $i = 1 To $lines[0]
        Local $line = StringStripWS($lines[$i], 3)
        If $line = "" Then ContinueLoop
        If StringLeft($line, 1) = ";" Then ContinueLoop

        If StringLeft($line, 1) = "[" And StringRight($line, 1) = "]" Then
            Local $section = StringTrimRight(StringTrimLeft($line, 1), 1)
            If StringLeft(StringLower($section), 5) = "vars." Then
                $scope = StringMid($section, 6)
                If $scope = "" Then $scope = "global"
            Else
                $scope = ""
            EndIf
            ContinueLoop
        EndIf

        If $scope = "" Then ContinueLoop
        If StringLeft($line, 1) <> "$" Then ContinueLoop

        Local $eq = StringInStr($line, "=")
        If $eq < 2 Then ContinueLoop

        Local $name = StringStripWS(StringMid($line, 2, $eq - 2), 3)
        Local $value = StringStripWS(StringMid($line, $eq + 1), 3)
        If $name = "" Then ContinueLoop

        If VarFindIndexedRow($scope, $name) >= 0 Then
            $gVarCompileError = "Duplicate var: " & $scope & ".$" & $name
            ReDim $gVarArray[0][5]
            ReDim $gVarIndex[0][3]
            GUICtrlSetData($status, $gVarCompileError)
            Return False
        EndIf

        Local $v1 = $value
        Local $v2 = ""
        Local $comma = StringInStr($value, ",")
        If $comma > 0 Then
            $v1 = StringStripWS(StringLeft($value, $comma - 1), 3)
            $v2 = StringStripWS(StringMid($value, $comma + 1), 3)
        EndIf

        $v1 = VarUnquote($v1)
        $v2 = VarUnquote($v2)

        Local $type = "scalar"
        If $v2 <> "" Then $type = "pair"

        VarAdd($scope, $name, $v1, $v2, $type)
    Next

    Return True

EndFunc

Func VarUnquote($value)

    If StringLen($value) >= 2 And StringLeft($value, 1) = '"' And StringRight($value, 1) = '"' Then
        $value = StringTrimLeft(StringTrimRight($value, 1), 1)
        $value = StringReplace($value, '""', '"')
    EndIf

    Return $value

EndFunc

Func VarAdd($scope, $name, $v1, $v2, $type)

    Local $row = UBound($gVarArray)
    ReDim $gVarArray[$row + 1][5]
    $gVarArray[$row][0] = $scope
    $gVarArray[$row][1] = $name
    $gVarArray[$row][2] = $v1
    $gVarArray[$row][3] = $v2
    $gVarArray[$row][4] = $type

    Local $idx = UBound($gVarIndex)
    ReDim $gVarIndex[$idx + 1][3]
    $gVarIndex[$idx][0] = $scope
    $gVarIndex[$idx][1] = $name
    $gVarIndex[$idx][2] = $row

EndFunc

Func VarFindIndexedRow($scope, $name)

    Local $s = StringLower($scope)
    Local $n = StringLower($name)

    For $i = 0 To UBound($gVarIndex) - 1
        If StringLower($gVarIndex[$i][0]) = $s And StringLower($gVarIndex[$i][1]) = $n Then Return Number($gVarIndex[$i][2])
    Next

    Return -1

EndFunc

Func VarFindRowForCompile($scope, $name)

    Local $row = VarFindIndexedRow($scope, $name)
    If $row >= 0 Then Return $row

    Return VarFindIndexedRow("global", $name)

EndFunc

Func VarCompileCommands($recScope = "")

    ReDim $gCompiledLines[UBound($gCurrLines)]
    $gVarCompileError = ""

    If $recScope = "" Then $recScope = $gLoadedRecordName
    If $recScope = "" Then $recScope = _CleanRecordName(RecordNameFromDisplay(GUICtrlRead($cmbFiles)))

    For $i = 1 To UBound($gCurrLines) - 1
        $gCompiledLines[$i] = VarCompileLine($gCurrLines[$i], $recScope)
        If $gVarCompileError <> "" Then
            GUICtrlSetData($status, $gVarCompileError)
            Return False
        EndIf
    Next

    Return True

EndFunc

Func VarCompileLine($line, $recScope)

    Local $trim = StringStripWS($line, 3)
    If $trim = "" Then Return ""
    If StringLeft($trim, 2) = ";=" Then Return ""

    Local $cmd = _CsvField($line, 1)
    If StringLeft($cmd, 7) = "Anchor_" Then Return _CompileAnchorLine($line, $recScope)
    If StringLeft($cmd, 4) = "MSP_" Then Return _CompileMspLine($line, $recScope)
    If StringLeft($cmd, 4) = "MSM_" Then Return _CompileMsmLine($line, $recScope)
    If StringLeft($cmd, 3) = "MD_" Then Return _CompileDragLine($line, $recScope)
    If StringLeft($cmd, 2) = "M_" Then Return _CompileMouseLine($line, $recScope)
    If StringLeft($cmd, 3) = "MM_" Then Return _CompileMouseMoveLine($line, $recScope)
    If StringLeft($cmd, 2) = "K_" Then Return _CompileKeyLine($line, $recScope)
    If StringLeft($cmd, 2) = "S_" Then Return _CompileStringLine($line, $recScope)
    If StringLeft($cmd, 3) = "MW_" Then Return _CompileWheelLine($line, $recScope)
    If StringLeft($cmd, 2) = "P_" Then Return _CompilePauseLine($line, $recScope)
    If StringLeft($cmd, 2) = "T_" Then Return _CompileDelayLine($line, $recScope)

    Return "ExecuteCommand(" & VarCodeQuote($line) & ")"

EndFunc
Func _CompileAnchorLine($line, $scope)

    Local $startPos = VarCompileField(_CsvField($line, 2), $scope, "", True)
    Local $endPos = VarCompileField(_CsvField($line, 3), $scope, "", True)
    Local $repeat = VarCompileField(_CsvField($line, 5), $scope, "1")
    Local $delay = VarCompileField(_CsvField($line, 6), $scope, "0")

    Return "HR_RunAnchor(" & $startPos & "," & $endPos & "," & $repeat & "," & $delay & ")"

EndFunc
