Func EnsureActionWorkspace()

    If Not $gTaskActive Then Return False

    $gActionName = HR_TaskNameFromPath($appPath)
    If $gActionName = "" Then $gActionName = "newtask"

    $gMicractsDir = $appPath & "\micracts"
    $gBlkDir = $appPath & "\blk"
    $gFlowFile = $appPath & "\" & $gActionName & ".tsk"
    $gEnvFile = $appPath & "\" & $gActionName & ".env"

    If Not FileExists($gMicractsDir) Then DirCreate($gMicractsDir)
    If Not FileExists($gBlkDir) Then DirCreate($gBlkDir)
    If Not FileExists($appPath & "\index") Then DirCreate($appPath & "\index")
    If Not FileExists($appPath & "\export") Then DirCreate($appPath & "\export")

    _EnsureActionEnv()
    If Not VarLoadEnv() Then Return False
    _MigrateRootRecordsToMicracts()
    _EnsureActionFlow()
    _NormalizeActionFlowExtensions()
    VarEnsureAllRecordDefaults()
    VarLoadEnv()

    Return True

EndFunc

Func _EnsureActionEnv()

    If FileExists($gEnvFile) Then Return

    Local $h = FileOpen($gEnvFile, 2)
    If $h = -1 Then Return

    FileWriteLine($h, ";= HandyRecorder action environment")
    FileWriteLine($h, "[Action]")
    FileWriteLine($h, "name=" & $gActionName)
    FileWriteLine($h, "version=1.90")
    FileWriteLine($h, "")
    FileWriteLine($h, "[Paths]")
    FileWriteLine($h, "micracts=micracts")
    FileWriteLine($h, "blk=blk")
    FileWriteLine($h, "index=index")
    FileWriteLine($h, "export=export")
    FileWriteLine($h, "")
    FileWriteLine($h, "[Vars.global]")
    FileWriteLine($h, "; $sample_xy=100,200")
    FileWriteLine($h, "; $sample_text=""hello""")

    FileClose($h)

EndFunc


