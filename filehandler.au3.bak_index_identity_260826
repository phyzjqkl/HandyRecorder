Func VarCompileField($field, $scope, $default = "", $asString = False)

    $field = StringStripWS($field, 3)
    If $field = "" Then $field = $default

    Local $expr = VarCompositeExpression($field, $scope)
    If $expr <> "" Then Return $expr

    $expr = VarFieldExpression($field, $scope)
    If $expr <> "" Then Return $expr

    If $asString Then Return VarCodeQuote(VarUnquote($field))
    Return VarNumericLiteral($field)

EndFunc

Func VarCompositeExpression($field, $scope)

    If StringInStr($field, "~") < 1 Then Return ""

    Local $parts = StringSplit($field, "~")
    If $parts[0] < 2 Then Return ""

    Local $left = VarFieldExpression(StringStripWS($parts[1], 3), $scope)
    Local $right = VarFieldExpression(StringStripWS($parts[2], 3), $scope)

    If $left = "" Or $right = "" Then Return ""

    Return $left & " & " & VarCodeQuote("~") & " & " & $right

EndFunc
Func VarFieldExpression($field, $scope)

    Local $m = StringRegExp($field, '^\$([A-Za-z_][A-Za-z0-9_]*)(?:\[([12])\])?$', 1)
    If @error Or Not IsArray($m) Then Return ""

    Local $name = $m[0]
    Local $slot = "1"
    If UBound($m) > 1 And $m[1] <> "" Then $slot = $m[1]

    Local $row = VarFindRowForCompile($scope, $name)
    If $row < 0 Then
        $gVarCompileError = "Missing var: " & $scope & ".$" & $name
        Return ""
    EndIf

    Local $col = 2
    If $slot = "2" Then $col = 3

    Return "$gVarArray[" & $row & "][" & $col & "]"

EndFunc

Func VarNumericLiteral($value)

    $value = VarUnquote($value)
    If $value = "" Then Return "0"
    If StringRegExp($value, '^-?\d+(\.\d+)?$') Then Return $value

    Return VarCodeQuote($value)

EndFunc

Func VarCodeQuote($value)

    $value = StringReplace($value, '"', '""')
    Return '"' & $value & '"'

EndFunc

Func VarGetValue($scope, $name, $default = "")

    Local $row = VarFindIndexedRow($scope, $name)
    If $row < 0 Then $row = VarFindIndexedRow("global", $name)
    If $row < 0 Then Return $default

    Return $gVarArray[$row][2]

EndFunc

Func VarCommandLineEnabled($recName, $lineIndex)

    If $lineIndex < 1 Then Return True
    Local $name = "enable_" & $lineIndex
    Local $row = VarFindIndexedRow(_CleanRecordName($recName), $name)
    If $row < 0 Then $row = VarFindIndexedRow("global", $name)
    If $row < 0 Then Return True

    Local $value = StringLower(StringStripWS($gVarArray[$row][2], 3))
    If $value = "" Then Return True
    If $value = "0" Or $value = "false" Or $value = "no" Or $value = "off" Then Return False
    Return True

EndFunc
Func VarRecordFlag($recName, $name, $default = "1")

    Local $value = StringLower(StringStripWS(VarGetValue(_CleanRecordName($recName), $name, $default), 3))
    If $value = "" Then $value = StringLower($default)

    If $value = "0" Or $value = "false" Or $value = "no" Or $value = "off" Then Return False
    Return True

EndFunc
