Func ReloadRecordList()

    TaskMarkMissingRecords()

    Local $name = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
    $name = _CleanRecordName($name)

    If $name = "" Or Not FileExists(RecordPath($name)) Then
        $name = GetStartupRecordName()
    EndIf

    If $name = "" Then $name = "record1"

    RefreshFiles($name)

    GUICtrlSetData($cmbFiles, TaskDisplayNameForRecord($name))

    $currentFile = RecordPath($name)
    $gLoadedRecordName = $name

    If FileExists($currentFile) Then
        LoadCommands($currentFile)
    Else
        GUICtrlSetData($cmbCmd, "|", "")
    EndIf

    GUICtrlSetData($status, "Idle")

EndFunc

























