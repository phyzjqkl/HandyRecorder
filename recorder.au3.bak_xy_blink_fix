; =====================================================
; REPLACE REM FIELD
; Expected mouse format:
; M_P1,x,y,L,1,,rem_mouse
;
; Expected offset mouse format:
; MSP_1_1,x,y,L,1,,rem_offset_base
;
; It preserves all fields before the rem field.
; =====================================================

Func _ReplaceRemField($line, $newRem)

    Local $p = StringSplit($line, ",")

    If $p[0] < 1 Then Return $line

    Local $out = ""

    ; If line has at least 7 fields, replace field 7.
    If $p[0] >= 7 Then

        For $i = 1 To 6

            If $i = 1 Then
                $out = $p[$i]
            Else
                $out &= "," & $p[$i]
            EndIf

        Next

        $out &= "," & $newRem

        Return $out

    EndIf

    ; fallback for short mouse lines
    For $i = 1 To $p[0]

        If $i = 1 Then
            $out = $p[$i]
        Else
            $out &= "," & $p[$i]
        EndIf

    Next

    While $p[0] < 6
        $out &= ","
        $p[0] += 1
    WEnd

    $out &= "," & $newRem

    Return $out

EndFunc

