; RECORD MOUSE DRAG
; =====================================================

Func _RecordMouseDrag($x1, $y1, $x2, $y2, $btn)

    If $gStringMode Then _CommitStringMode()

    AppendCommand("MD_D1," & $x1 & "~" & $x2 & "," & $y1 & "~" & $y2 & "," & $btn & ",10,,rem_drag")

    If _AutoCommentEnabled() Then
        _ApplyAutoCommentToActiveDragLine($x1, $y1, $x2, $y2)
    EndIf

EndFunc

; =====================================================
; RECORD MANUAL MOUSE MOVE / HOVER
; Shift+F8 by default. This is intentional, not automatic,
; so normal recording does not collect noisy hover points.
; =====================================================

Func RecordMouseMoveHotkey()

    If Not $recording Then Return
    If $gRecordPaused Then Return

    If $gStringMode Then _CommitStringMode()

    Local $m = MouseGetPos()
    AppendCommand("MM_M1," & $m[0] & "," & $m[1] & ",0,1,,rem_move")

    If _AutoCommentEnabled() Then
        _ApplyAutoCommentToActiveMouseLine($m[0], $m[1])
    EndIf

EndFunc

Func ToggleOffsetMouseMarkerHotkey()

    If Not $recording Then Return
    If $gRecordPaused Then Return
    If $gStringMode Then _CommitStringMode()

    Local $m = MouseGetPos()

    If Not $offsetMode Then
        $offsetMode = True
        $offsetBaseSet = False
        $offsetBaseX = 0
        $offsetBaseY = 0
        $offsetCount = 0
        $offsetGroup += 1
        $offsetF8StartX = $m[0]
        $offsetF8StartY = $m[1]
        $offsetAnchorRegionSet = False
        $offsetAnchorSet = False

        AppendCommandToEnd(";= Offset Start " & $offsetGroup)
        $offsetF8StartIndex = $gActiveIndex

        GUICtrlSetData($status, "OffsetOn")
        Return
    EndIf

    If Not $offsetAnchorRegionSet Then
        _RecordAnchorRegionCommand($offsetF8StartX, $offsetF8StartY, $m[0], $m[1])
        $offsetAnchorRegionSet = True
        If _AutoCommentEnabled() Then _ApplyAutoCommentToActiveMouseLineRegion($offsetF8StartX, $offsetF8StartY, $m[0], $m[1])
        GUICtrlSetData($status, "OffsetOn")
        Return
    EndIf

    AppendCommandToEnd(";= Offset End " & $offsetGroup)

    $offsetMode = False
    $offsetBaseSet = False
    $offsetCount = 1
    $offsetF8StartIndex = 0
    $offsetAnchorRegionSet = False
    $offsetAnchorSet = False

    GUICtrlSetData($status, "Recording")

EndFunc

Func _RecordAnchorRegionCommand($x1, $y1, $x2, $y2)

    Local $line = "Anchor_" & $offsetGroup & "," & $x1 & "~" & $x2 & "," & $y1 & "~" & $y2 & ",,1,,rem_anchor_region"

    If Not $offsetAnchorSet Then
        AppendCommandToEnd($line)
        Return
    EndIf

    Local $insertAfter = 0
    For $i = UBound($gCurrLines) - 1 To 1 Step -1
        If StringStripWS($gCurrLines[$i], 3) = ";= Offset Start " & $offsetGroup Then
            $insertAfter = $i
            ExitLoop
        EndIf
    Next

    If $insertAfter < 1 Then
        AppendCommandToEnd($line)
        Return
    EndIf

    Local $total = UBound($gCurrLines) - 1
    Local $new[1]
    Local $count = 0
    Local $insertIndex = $insertAfter + 1

    For $i = 1 To $total
        $count += 1
        ReDim $new[$count + 1]
        $new[$count] = $gCurrLines[$i]

        If $i = $insertAfter Then
            $count += 1
            ReDim $new[$count + 1]
            $new[$count] = $line
        EndIf
    Next

    $gCurrLines = $new
    $gActiveIndex = $insertIndex
    $gLastVisibleText = $line
    _RenderCommands($insertIndex)

EndFunc

; =====================================================
; RECORD MOUSE CLICK
; =====================================================

Func _RecordMouseClick($x, $y, $btn)

    If $gStringMode Then _CommitStringMode()

    Local $line = ""

    If $offsetMode Then

        If Not $offsetAnchorSet Then

            $offsetBaseX = $x
            $offsetBaseY = $y
            $offsetBaseSet = True
            $offsetAnchorSet = True
            $offsetCount = 1

            $line = _
                "MSP_" & _
                $offsetGroup & _
                "_1," & _
                $offsetBaseX & "," & _
                $offsetBaseY & "," & _
                $btn & ",1,,rem_idx_anchor"

        Else

            $offsetCount += 1

            Local $dx = $x - $offsetBaseX
            Local $dy = $y - $offsetBaseY

            $line = _
                "MSP_" & _
                $offsetGroup & _
                "_" & _
                $offsetCount & "," & _
                $dx & "," & _
                $dy & "," & _
                $btn & ",1,,rem_offset"

        EndIf

    Else

        Local $rem = "rem_mouse"

        If $btn = "C" Then
            $rem = "rem_wheel"
        EndIf

        $line = _
            "M_P1," & _
            $x & "," & _
            $y & "," & _
            $btn & ",1,," & _
            $rem

    EndIf

    ; 1) create command line first
    AppendCommand($line)

    ; 2) then update rem field and crop image.
    ; This avoids any later UI/tooltips blocking the screenshot.
    If _AutoCommentEnabled() Then
        _ApplyAutoCommentToActiveMouseLine($x, $y)
    EndIf

EndFunc

Func _RecordMouseDown($x, $y, $btn)

    If $gStringMode Then _CommitStringMode()

    AppendCommand("M_D1," & $x & "," & $y & "," & $btn & ",1,,rem_down")

    If _AutoCommentEnabled() Then
        _ApplyAutoCommentToActiveMouseLine($x, $y)
    EndIf

EndFunc

Func _UpdateMouseDownDelay($seconds)

    If $gActiveIndex < 1 Then Return
    If $gActiveIndex > UBound($gCurrLines) - 1 Then Return

    Local $line = $gCurrLines[$gActiveIndex]
    Local $p = StringSplit($line, ",")
    If $p[0] < 7 Then Return
    If StringLeft($p[1], 3) <> "M_D" Then Return

    $gCurrLines[$gActiveIndex] = $p[1] & "," & $p[2] & "," & $p[3] & "," & $p[4] & "," & $p[5] & "," & $seconds & "," & $p[7]
    $gLastVisibleText = $gCurrLines[$gActiveIndex]
    _RenderCommands($gActiveIndex)

EndFunc

Func _RecordMouseUp($x, $y, $btn)

    If $gStringMode Then _CommitStringMode()

    AppendCommand("M_U1," & $x & "," & $y & "," & $btn & ",1,,rem_up")

EndFunc
