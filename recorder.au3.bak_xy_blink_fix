; CAPTURE SCREEN CROP AROUND MOUSE POSITION
;
; INI:
; [AutoComment]
; crop_w=20
; crop_h=40
;
; If near screen edge, shift rectangle back inside screen.
; =====================================================

Func _CaptureMouseCrop($x, $y, $file)

    Local $w = Number(IniRead($iniFile, "AutoComment", "crop_w", "20"))
    Local $h = Number(IniRead($iniFile, "AutoComment", "crop_h", "40"))

    If $w < 2 Then $w = 20
    If $h < 2 Then $h = 40

    Local $left = $x - Int($w / 2)
    Local $top = $y - Int($h / 2)

    If $left < 0 Then $left = 0
    If $top < 0 Then $top = 0

    If $left + $w > @DesktopWidth Then
        $left = @DesktopWidth - $w
    EndIf

    If $top + $h > @DesktopHeight Then
        $top = @DesktopHeight - $h
    EndIf

    If $left < 0 Then $left = 0
    If $top < 0 Then $top = 0

    Local $right = $left + $w - 1
    Local $bottom = $top + $h - 1

    _ScreenCapture_Capture($file, $left, $top, $right, $bottom, False)

EndFunc

; =====================================================
; RECORD MOUSE WHEEL WITH ROTATION COUNT
; Consecutive same-direction wheel events update the last line.
; =====================================================

Func _RecordWheel($dir)

    If $gStringMode Then _CommitStringMode()

    If _TryMergeWheel($dir) Then Return

    Local $line = _
        "MW_W1," & _
        $dir & _
        ",1,,rem_wheel"

    AppendCommand($line)

EndFunc

; =====================================================
; TRY MERGE WHEEL WITH LAST LINE
; =====================================================

Func _TryMergeWheel($dir)

    Local $nLast = UBound($gCurrLines) - 1

    If $nLast < 1 Then Return False

    Local $last = StringStripWS($gCurrLines[$nLast], 3)

    If StringLeft($last, 3) <> "MW_" Then Return False

    Local $p = StringSplit($last, ",")

    If $p[0] < 3 Then Return False
    If $p[2] <> $dir Then Return False

    Local $repeat = Number($p[3])

    If $repeat < 1 Then $repeat = 1

    $repeat += 1

    $gCurrLines[$nLast] = _
        $p[1] & "," & _
        $dir & "," & _
        $repeat & ",,rem_wheel"

    $gActiveIndex = $nLast
    $gLastVisibleText = $gCurrLines[$nLast]

    _RenderCommands($nLast)

    Return True

EndFunc

; =====================================================
; STRING INPUT HOTKEY
; Configured by [Hotkeys] string_toggle.
; =====================================================

Func ToggleStringRecord()

    If Not $recording Then Return

    If Not $gStringMode Then
        $gStringMode = True
        $gStringBuffer = ""
        _ResetKeyStates()
        GUICtrlSetData($status, "StringOn")
        Return
    EndIf

    _CommitStringMode()

EndFunc

Func TogglePauseRecord()

    If Not $recording Then Return

    If Not $gRecordPaused Then
        If $gStringMode Then _CommitStringMode()

        AppendCommand('P_P1,"",1,,rem_pause')

        $gRecordPaused = True
        $gRecordPauseIndex = $gActiveIndex
        $gRecordPauseTimer = TimerInit()
        $mouseWasDown = False
        $mouseButton = ""
        $mouseDownInUI = False
        _ResetKeyStates()
        _HideRecorderTooltip()
        GUICtrlSetData($status, "RecPause")
        Return
    EndIf

    $gRecordPaused = False
    _UpdatePauseDelayFromRecordTimer()
    $gRecordPauseIndex = 0
    $mouseWasDown = False
    $mouseButton = ""
    $mouseDownInUI = False
    _ResetKeyStates()
    $gTooltipLastTimer = TimerInit()

    If $offsetMode Then
        GUICtrlSetData($status, "OffsetOn")
    Else
        GUICtrlSetData($status, "Recording")
    EndIf

EndFunc

Func _RecorderSetFocusPauseLine($line)

    Local $trim = StringStripWS($line, 3)
    If StringLeft($trim, 4) = "P_F1" Then Return $line
    If StringLeft($trim, 3) = "P_F" Then Return $line

    Local $comma = StringInStr($line, ",")
    If $comma > 0 Then Return "P_F1" & StringMid($line, $comma)

    Return 'P_F1,"",1,,rem_focus_pause'

EndFunc

Func RecordManualFocusResume()

    If Not $recording Then Return
    If Not $gRecordPaused Then Return
    If $gRecordPauseIndex < 1 Then Return
    If $gRecordPauseIndex > UBound($gCurrLines) - 1 Then Return

    Local $line = $gCurrLines[$gRecordPauseIndex]
    If StringLeft(StringStripWS($line, 3), 2) <> "P_" Then Return

    Local $newLine = _RecorderSetFocusPauseLine(_RecorderSetCsvField($line, 4, ""))

    $gCurrLines[$gRecordPauseIndex] = $newLine
    $gActiveIndex = $gRecordPauseIndex
    $gLastVisibleText = $newLine
    _RenderCommands($gRecordPauseIndex)
    GUICtrlSetData($cmbCmd, $newLine)

    $gRecordPaused = False
    $gRecordPauseIndex = 0
    $gRecordManualFocusWait = True
    $gRecordManualFocusWasDown = _IsPressed("01")
    $mouseWasDown = False
    $mouseButton = ""
    $mouseDownInUI = False
    _ResetKeyStates()
    _HideRecorderTooltip()
    GUICtrlSetData($status, _FocusPauseClickLabel() & " target")

EndFunc

Func RecordManualFocusTick()

    If Not $gRecordManualFocusWait Then Return

    Local $leftDown = _IsPressed("01")

    If $gRecordManualFocusWasDown Then
        If Not $leftDown Then $gRecordManualFocusWasDown = False
        Return
    EndIf

    If Not $leftDown Then
        GUICtrlSetData($status, _FocusPauseClickLabel() & " target")
        Return
    EndIf

    If _MouseInsideRecorderUI() Then Return

    While _IsPressed("01")
        Sleep(5)
    WEnd

    $gRecordManualFocusWait = False
    $gRecordManualFocusWasDown = False
    $mouseWasDown = False
    $mouseButton = ""
    $mouseDownInUI = False
    _ResetKeyStates()
    $gTooltipLastTimer = TimerInit()

    If $offsetMode Then
        GUICtrlSetData($status, "OffsetOn")
    Else
        GUICtrlSetData($status, "Recording")
    EndIf

EndFunc

Func _RecorderAppendManualFocusRem($line)
    Return _RecorderSetFocusPauseLine($line)
EndFunc

Func _UpdatePauseDelayFromRecordTimer()

    If $gRecordPauseIndex < 1 Then Return
    If $gRecordPauseIndex > UBound($gCurrLines) - 1 Then Return

    Local $seconds = TimerDiff($gRecordPauseTimer) / 1000
    Local $line = $gCurrLines[$gRecordPauseIndex]

    If StringLeft($line, 2) <> "P_" Then Return

    Local $newLine = _RecorderSetCsvField($line, 4, _FormatSeconds($seconds))

    $gCurrLines[$gRecordPauseIndex] = $newLine
    $gLastVisibleText = $newLine
    _RenderCommands($gRecordPauseIndex)

EndFunc

Func _RecorderSetCsvField($line, $target, $value)

    Local $field = 1
    Local $out = ""
    Local $inQuote = False
    Local $len = StringLen($line)
    Local $replaced = False

    For $i = 1 To $len

        Local $ch = StringMid($line, $i, 1)

        If $ch = '"' Then
            If $inQuote And $i < $len And StringMid($line, $i + 1, 1) = '"' Then
                If $field <> $target Then $out &= '""'
                $i += 1
                ContinueLoop
            EndIf

            $inQuote = Not $inQuote
            If $field <> $target Then $out &= $ch
            ContinueLoop
        EndIf

        If $ch = "," And Not $inQuote Then
            If $field = $target Then
                $out &= $value
                $replaced = True
            EndIf

            $out &= ","
            $field += 1
            ContinueLoop
        EndIf

        If $field <> $target Then $out &= $ch

    Next

    If $field = $target Then
        $out &= $value
        $replaced = True
    EndIf

    While Not $replaced And $field < $target
        $out &= ","
        $field += 1
        If $field = $target Then
            $out &= $value
            $replaced = True
        EndIf
    WEnd

    Return $out

EndFunc

Func _CommitStringMode()

    If StringLen($gStringBuffer) > 0 Then
        Local $line = _
            'S_S1,"' & _
            StringReplace($gStringBuffer, '"', '""') & _
            '",1,,rem_string'

        AppendCommand($line)
    EndIf

    $gStringMode = False
    $gStringBuffer = ""
    _ResetKeyStates()

    If $offsetMode Then
        GUICtrlSetData($status, "OffsetOn")
    Else
        GUICtrlSetData($status, "Recording")
    EndIf

EndFunc

; =====================================================
; OFFSET MODE HOTKEY
; Ctrl+Shift+O
; =====================================================

Func ToggleOffsetMode()

    If Not $recording Then Return

    If Not $offsetMode Then

        $offsetMode = True
        $offsetBaseSet = False
        $offsetCount = 1
        $offsetGroup += 1
        $offsetF8StartIndex = 0
        $offsetAnchorRegionSet = False
        $offsetAnchorSet = False

        AppendCommandToEnd(";= Offset Start " & $offsetGroup)

        GUICtrlSetData($status, "OffsetOn")

    Else

        AppendCommandToEnd(";= Offset End " & $offsetGroup)

        $offsetMode = False
        $offsetBaseSet = False
        $offsetCount = 1
        $offsetF8StartIndex = 0
        $offsetAnchorRegionSet = False
        $offsetAnchorSet = False

        GUICtrlSetData($status, "Recording")

    EndIf

EndFunc

; =====================================================
; CHECK WHETHER MOUSE IS INSIDE RECORDER UI
; =====================================================

Func _MouseInsideRecorderUI()

    If _MouseInsideWindow($gui) Then Return True

    If _MouseInsideReviewWindow() Then Return True
    If $gTaskMode And _MouseInsideWindow($gTaskGui) Then Return True

    Return False

EndFunc

Func _MouseInsideWindow($hwnd)

    If $hwnd = 0 Then Return False

    Local $pos = WinGetPos($hwnd)
    If Not IsArray($pos) Then Return False

    Local $m = MouseGetPos()

    If $m[0] >= $pos[0] _
        And $m[0] <= ($pos[0] + $pos[2]) _
        And $m[1] >= $pos[1] _
        And $m[1] <= ($pos[1] + $pos[3]) Then Return True

    Return False

EndFunc








