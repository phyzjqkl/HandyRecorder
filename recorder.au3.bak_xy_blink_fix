; =====================================================
; LOW LEVEL MOUSE WHEEL HOOK
; Use HR_ names to avoid conflict with AutoIt constants.
; =====================================================

Global Const $HR_WH_MOUSE_LL = 14
Global Const $HR_WM_MOUSEWHEEL = 0x020A

Global $g_hMouseHook = 0
Global $g_hMouseHookCallback = 0
Global $g_lastWheelTime = 0

_InitKeyWatch()
_InitWheelHook()

; =====================================================
; INIT GLOBAL MOUSE WHEEL HOOK
; =====================================================

Func _InitWheelHook()

    If $g_hMouseHook <> 0 Then Return

    $g_hMouseHookCallback = DllCallbackRegister("_MouseHookProc", "long", "int;wparam;lparam")

    If @error Then Return

    $g_hMouseHook = _WinAPI_SetWindowsHookEx( _
        $HR_WH_MOUSE_LL, _
        DllCallbackGetPtr($g_hMouseHookCallback), _
        _WinAPI_GetModuleHandle(0), _
        0)

EndFunc

; =====================================================
; MOUSE HOOK PROC
; Records wheel rotation count globally during Rec.
; =====================================================

Func _MouseHookProc($nCode, $wParam, $lParam)

    If $nCode >= 0 And $wParam = $HR_WM_MOUSEWHEEL Then

        If $recording And Not $running And Not $gRecordPaused Then

            If Not WinActive($gui) And Not _MouseInsideRecorderUI() Then

                Local $t = DllStructCreate( _
                    "long X;long Y;dword MouseData;dword Flags;dword Time;ulong_ptr ExtraInfo", _
                    $lParam)

                Local $mouseData = DllStructGetData($t, "MouseData")
                Local $delta = BitShift(BitAND($mouseData, 0xFFFF0000), 16)

                If $delta > 32767 Then
                    $delta -= 65536
                EndIf

                If TimerDiff($g_lastWheelTime) > 25 Then

                    If $delta > 0 Then
                        _RecordWheel("UP")
                    ElseIf $delta < 0 Then
                        _RecordWheel("DOWN")
                    EndIf

                    $g_lastWheelTime = TimerInit()

                EndIf

            EndIf

        EndIf

    EndIf

    Return _WinAPI_CallNextHookEx($g_hMouseHook, $nCode, $wParam, $lParam)

EndFunc

; =====================================================
; ADD KEY TO WATCH LIST
; =====================================================

Func _AddKey($hex, $sendName)

    $keyTotal += 1

    $keyCode[$keyTotal] = $hex
    $keyName[$keyTotal] = $sendName
    $keyDown[$keyTotal] = False

EndFunc

; =====================================================
; INIT KEY WATCH LIST
; Records alphabetic, numeric, symbol, function,
; navigation keys.
;
; AutoIt Send grammar:
; ^ = Ctrl
; ! = Alt
; + = Shift
; # = Win
; =====================================================

Func _InitKeyWatch()

    $keyTotal = 0

    ; =================================================
    ; A-Z
    ; =================================================

    _AddKey("41", "a")
    _AddKey("42", "b")
    _AddKey("43", "c")
    _AddKey("44", "d")
    _AddKey("45", "e")
    _AddKey("46", "f")
    _AddKey("47", "g")
    _AddKey("48", "h")
    _AddKey("49", "i")
    _AddKey("4A", "j")
    _AddKey("4B", "k")
    _AddKey("4C", "l")
    _AddKey("4D", "m")
    _AddKey("4E", "n")
    _AddKey("4F", "o")
    _AddKey("50", "p")
    _AddKey("51", "q")
    _AddKey("52", "r")
    _AddKey("53", "s")
    _AddKey("54", "t")
    _AddKey("55", "u")
    _AddKey("56", "v")
    _AddKey("57", "w")
    _AddKey("58", "x")
    _AddKey("59", "y")
    _AddKey("5A", "z")

    ; =================================================
    ; 0-9
    ; =================================================

    _AddKey("30", "0")
    _AddKey("31", "1")
    _AddKey("32", "2")
    _AddKey("33", "3")
    _AddKey("34", "4")
    _AddKey("35", "5")
    _AddKey("36", "6")
    _AddKey("37", "7")
    _AddKey("38", "8")
    _AddKey("39", "9")

    ; =================================================
    ; OEM SYMBOL KEYS
    ;
    ; These support:
    ; = +  , <  - _  . >  / ?
    ; ; :  [ {  ] }  \ |  ` ~  ' "
    ;
    ; Shift is automatically added by _BuildAutoItKey().
    ; Example:
    ; Shift + . becomes +.
    ; Shift + / becomes +/
    ; Shift + = becomes +=
    ; =================================================

    _AddKey("BB", "=")   ; = +
    _AddKey("BC", ",")   ; , <
    _AddKey("BD", "-")   ; - _
    _AddKey("BE", ".")   ; . >
    _AddKey("BF", "/")   ; / ?
    _AddKey("BA", ";")   ; ; :
    _AddKey("DB", "[")   ; [ {
    _AddKey("DD", "]")   ; ] }
    _AddKey("DC", "\")   ; \ |
    _AddKey("C0", "`")   ; ` ~
    _AddKey("DE", "'")   ; ' "

    ; =================================================
    ; Functional / navigation keys
    ; =================================================

    _AddKey("09", "{TAB}")
    _AddKey("0D", "{ENTER}")
    _AddKey("1B", "{ESC}")
    _AddKey("08", "{BACKSPACE}")
    _AddKey("2E", "{DELETE}")
    _AddKey("2D", "{INSERT}")
    _AddKey("24", "{HOME}")
    _AddKey("23", "{END}")
    _AddKey("21", "{PGUP}")
    _AddKey("22", "{PGDN}")
    _AddKey("26", "{UP}")
    _AddKey("28", "{DOWN}")
    _AddKey("25", "{LEFT}")
    _AddKey("27", "{RIGHT}")
    _AddKey("20", "{SPACE}")

    ; =================================================
    ; F1-F12
    ; =================================================

    _AddKey("70", "{F1}")
    _AddKey("71", "{F2}")
    _AddKey("72", "{F3}")
    _AddKey("73", "{F4}")
    _AddKey("74", "{F5}")
    _AddKey("75", "{F6}")
    _AddKey("76", "{F7}")
    _AddKey("77", "{F8}")
    _AddKey("78", "{F9}")
    _AddKey("79", "{F10}")
    _AddKey("7A", "{F11}")
    _AddKey("7B", "{F12}")

EndFunc

; =====================================================
; TOGGLE RECORD
; Rec = record into current active buffer
; Off = save recording buffer
; =====================================================

Func ToggleRecord()

    If Not $recording Then
        If Not $gTaskActive Then
            GUICtrlSetData($status, "NoTask")
            Return
        EndIf

        If $runPaused Then
            _BeginPatchRecordBuffer()
        ElseIf HR_CurrentRunMode() = "MF" And Not $running Then
            _BeginManualFlowPatchRecordBuffer()
        Else
            $gPlaybackRecordInsert = False
            $gPlaybackRecordResumeIndex = 0
            $gPatchRecordMode = False
            $gPatchInsertIndex = 0
            $gMFDirectPatchMode = False
            $gMFDirectPatchResumeIndex = 0
        EndIf

        $recording = True

        $offsetMode = False
        $offsetBaseSet = False
        $offsetCount = 1
        $offsetGroup = 0
        $offsetF8StartIndex = 0
        $offsetF8StartX = 0
        $offsetF8StartY = 0
        $offsetAnchorRegionSet = False
        $offsetAnchorSet = False

        $mouseWasDown = False
        $mouseButton = ""
        $mouseDownInUI = False
        $mouseDownX = 0
        $mouseDownY = 0
        $mouseDownTimer = TimerInit()
        $mouseLongPressActive = False

        $gTooltipLastTimer = TimerInit()
        $gTooltipVisible = False
        $gTooltipOneShot = False
        $gTooltipOneShotTimer = TimerInit()

        $keyCount = 0
        $gLastKeyTimer = TimerInit()
        $gStringMode = False
        $gStringBuffer = ""
        If $gRecordPaused Then _UpdatePauseDelayFromRecordTimer()
        $gRecordPaused = False
        $gRecordPauseIndex = 0
        $gRecordPauseTimer = TimerInit()
        $gRecordManualFocusWait = False
        $gRecordManualFocusWasDown = False
        _ResetKeyStates()

        ; -------------------------------------------------
        ; During recording, reuse Auto checkbox as Auto Comment.
        ; Idle:   Auto = repeat playback
        ; Record: ACmt = auto screenshot/comment crop
        ; -------------------------------------------------

        $gSavedRepeatState = GUICtrlRead($chkRepeat)

        GUICtrlSetData($chkRepeat, "ACmt")

        If IniRead($iniFile, "AutoComment", "enabled", "1") = "1" Then
            GUICtrlSetState($chkRepeat, $GUI_CHECKED)
        Else
            GUICtrlSetState($chkRepeat, $GUI_UNCHECKED)
        EndIf

        ; -------------------------------------------------
        ; Auto comment image index
        ; -------------------------------------------------

        $gAutoCommentIndex = 1
        $gAutoCommentBase = _GetCurrentRecordBaseName()

        DirCreate($appPath & "\index")
        DirCreate($appPath & "\export")

        GUICtrlSetData($btnRec, "Off")
        If $gPatchRecordMode Then
            GUICtrlSetData($status, "PatchRec")
        Else
            GUICtrlSetData($status, "Recording")
        EndIf

    Else

        If $offsetMode Then
            AppendCommandToEnd(";= Offset End " & $offsetGroup)
            $offsetMode = False
            $offsetBaseSet = False
            $offsetAnchorRegionSet = False
            $offsetAnchorSet = False
            $offsetF8StartIndex = 0
        EndIf

        If $gStringMode Then
            _CommitStringMode()
        EndIf

        $gRecordPaused = False
        $gRecordPauseIndex = 0
        $gRecordManualFocusWait = False
        $gRecordManualFocusWasDown = False

        _HideRecorderTooltip()

        If $gPatchRecordMode Then
            _FinishPatchRecordBuffer()
        Else
            SaveCurrentData()
        EndIf

        ; restore Auto Repeat checkbox after recording
        GUICtrlSetData($chkRepeat, "Auto")
        GUICtrlSetState($chkRepeat, $gSavedRepeatState)

        $recording = False

        GUICtrlSetData($btnRec, "Rec")

        If $gPlaybackRecordInsert Then
            ReloadPausedRunAfterRecord($gPlaybackRecordResumeIndex, $gPlaybackRecordDisplayIndex)
            $gPlaybackRecordInsert = False
            $gPlaybackRecordResumeIndex = 0
            $gPlaybackRecordDisplayIndex = 0
        ElseIf $running Then
            GUICtrlSetData($status, "Running")
        ElseIf $runPaused Then
            GUICtrlSetData($status, "Pause")
        Else
            GUICtrlSetData($status, "Idle")
        EndIf

    EndIf

EndFunc

Func CreateNewRecordAndStartRecording()

    If $recording Or $running Or $runPaused Then
        GUICtrlSetData($status, "NoNestRec")
        Return
    EndIf
    If Not $gTaskActive Then
        GUICtrlSetData($status, "NoTask")
        Return
    EndIf

    SaveCurrentData()
    CreateNewRecord()
    ToggleRecord()

EndFunc

Func SaveRecordButtonAction()

    If $recording And $gPatchRecordMode Then
        If $gPatchNewRecordMode Then
            SaveCurrentDataNoFlow()
        Else
            _SyncActiveFromUI()
            Review_SyncEditRem()
            _PruneEmptyCommandLines()
            _RenderCommands($gActiveIndex)
            GUICtrlSetData($status, "PatchRec")
        EndIf
        Return
    EndIf

    SaveCurrentData()

EndFunc

Func _BeginPatchRecordBuffer()

    $gPatchRecordMode = True
    $gPlaybackRecordInsert = True
    $gPlaybackRecordResumeIndex = $runPausedIndex
    $gPlaybackRecordDisplayIndex = 0
    If $gPlaybackRecordResumeIndex < 1 Then $gPlaybackRecordResumeIndex = $gActiveIndex
    If $gPlaybackRecordResumeIndex < 1 Then $gPlaybackRecordResumeIndex = 1
    $gPatchInsertIndex = $gPlaybackRecordResumeIndex
    $gPatchNewRecordMode = False
    $gPatchNewRecordUsed = False
    $gPatchSourceFile = $currentFile
    $gPatchSourceName = _PatchRecordNameFromPath($gPatchSourceFile)
    If $gPatchSourceName = "" Then $gPatchSourceName = _CleanRecordName($gLoadedRecordName)
    If $gPatchSourceName = "" Then $gPatchSourceName = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
    $gPatchTaskAfterName = $gPatchSourceName

    $gPatchMainLines = $gCurrLines
    $gPatchMainActiveIndex = $gActiveIndex
    $gPatchMainLastVisibleText = $gLastVisibleText

    ReDim $gCurrLines[1]
    $gActiveIndex = 0
    $gLastVisibleText = ""
    _RenderCommands(0)

EndFunc

Func _PatchRecordNameFromPath($file)

    $file = StringStripWS($file, 3)
    If $file = "" Then Return ""

    Local $pos = StringInStr($file, "\", 0, -1)
    Local $name = $file
    If $pos > 0 Then $name = StringMid($file, $pos + 1)

    Return _CleanRecordName($name)

EndFunc

Func _BeginManualFlowPatchRecordBuffer()

    $gPatchRecordMode = True
    $gPlaybackRecordInsert = False
    $gMFDirectPatchMode = True
    $gMFDirectPatchResumeIndex = 0
    Local $insertBase = _RecordInsertBaseIndex(_FindActiveIndex())
    If $insertBase < 1 Then $insertBase = _FindActiveIndex()
    If $insertBase < 1 Then $insertBase = 1
    $gPatchInsertIndex = $insertBase
    $gPatchNewRecordMode = False
    $gPatchNewRecordUsed = False
    $gPatchSourceFile = $currentFile
    $gPatchSourceName = _PatchRecordNameFromPath($gPatchSourceFile)
    If $gPatchSourceName = "" Then $gPatchSourceName = _CleanRecordName($gLoadedRecordName)
    If $gPatchSourceName = "" Then $gPatchSourceName = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
    $gPatchTaskAfterName = $gPatchSourceName

    $gPatchMainLines = $gCurrLines
    $gPatchMainActiveIndex = $gActiveIndex
    $gPatchMainLastVisibleText = $gLastVisibleText

    ReDim $gCurrLines[1]
    $gActiveIndex = 0
    $gLastVisibleText = ""
    _RenderCommands(0)

EndFunc

Func _CreatePatchNewRecordBuffer()

    If Not $gPatchRecordMode Then Return
    If $gPatchNewRecordUsed Then
        GUICtrlSetData($status, "OneNewOnly")
        Return
    EndIf

    Local $name = _
        "rec_" & _
        @YEAR & @MON & @MDAY & "_" & _
        @HOUR & @MIN & @SEC

    $name = _UniqueRecordName($name)

    $gPatchNewRecordMode = True
    $gPatchNewRecordUsed = True
    $currentFile = RecordPath($name)
    $gLoadedRecordName = $name
    $gAutoCommentIndex = 1
    $gAutoCommentBase = _GetCurrentRecordBaseName()

    RefreshFilesWithExtra($name, $name)
    GUICtrlSetData($cmbFiles, TaskDisplayNameForRecord($name))
    If UBound($gCurrLines) <= 1 Then
        ReDim $gCurrLines[1]
        $gActiveIndex = 0
        $gLastVisibleText = ""
        _RenderCommands(0)
    Else
        _RenderCommands($gActiveIndex)
    EndIf

    GUICtrlSetData($status, "PatchRec")

EndFunc

Func _FinishPatchRecordBuffer()

    If $gMFDirectPatchMode Then
        Local $patchLines = $gCurrLines

        $gCurrLines = $gPatchMainLines
        $gActiveIndex = $gPatchMainActiveIndex
        $gLastVisibleText = $gPatchMainLastVisibleText

        Local $patchCount = InsertPatchLinesAfter($gPatchInsertIndex, $patchLines)
        SaveCurrentData()

        Local $firstInserted = $gPatchInsertIndex + 1
        If $patchCount > 0 Then
            If $firstInserted < 1 Then $firstInserted = 1
            If $firstInserted > UBound($gCurrLines) - 1 Then $firstInserted = UBound($gCurrLines) - 1
            If $firstInserted >= 1 Then
                $gActiveIndex = $firstInserted
                $gLastVisibleText = $gCurrLines[$gActiveIndex]
                _RenderCommands($gActiveIndex)
                GUICtrlSetData($cmbCmd, $gCurrLines[$gActiveIndex])
            EndIf
        EndIf

        $gPatchRecordMode = False
        $gMFDirectPatchMode = False
        $gMFDirectPatchResumeIndex = 0
        $gPatchInsertIndex = 0
        $gPatchNewRecordMode = False
        $gPatchNewRecordUsed = False
        $gPatchSourceFile = ""
        $gPatchSourceName = ""
        $gPatchTaskAfterName = ""
        $gPatchSavedPrompt = False
        $gMFStepReady = True
        GUICtrlSetData($status, "Idle")
        Return
    EndIf
    If $gPatchNewRecordMode Then
        SaveCurrentDataNoFlow()

        Local $newName = RecordNameFromDisplay(GUICtrlRead($cmbFiles))
        If $newName = "" Then $newName = $gLoadedRecordName

        InsertFlowNameAfter($gPatchTaskAfterName, $newName)

        $currentFile = $gPatchSourceFile
        $gLoadedRecordName = $gPatchSourceName
        RefreshFiles($gPatchSourceName)
        GUICtrlSetData($cmbFiles, $gPatchSourceName)
        If FileExists($currentFile) Then LoadCommands($currentFile)

        $gPlaybackRecordResumeIndex = $gPatchInsertIndex
        $gPlaybackRecordDisplayIndex = $gPatchInsertIndex
        $gPatchRecordMode = False
        $gPatchNewRecordMode = False
        $gPatchInsertIndex = 0
        $gPatchSourceFile = ""
        $gPatchSourceName = ""
        $gPatchTaskAfterName = ""
        $gPatchSavedPrompt = True
        Return
    EndIf

    Local $patchLines = $gCurrLines

    $gCurrLines = $gPatchMainLines
    $gActiveIndex = $gPatchMainActiveIndex
    $gLastVisibleText = $gPatchMainLastVisibleText

    Local $patchCount = InsertPatchLinesAfter($gPatchInsertIndex, $patchLines)
    SaveCurrentData()

    $gPatchRecordMode = False
    $gPlaybackRecordResumeIndex = $gPatchInsertIndex + $patchCount
    $gPlaybackRecordDisplayIndex = $gPlaybackRecordResumeIndex + 1
    $gPatchInsertIndex = 0
    $gPatchNewRecordMode = False
    $gPatchSourceFile = ""
    $gPatchSourceName = ""
    $gPatchTaskAfterName = ""
    $gPatchSavedPrompt = True

EndFunc
; =====================================================
; RESET KEY STATES
; =====================================================

Func _ResetKeyStates()

    For $i = 1 To $keyTotal
        $keyDown[$i] = False
    Next

EndFunc

; =====================================================
; POLL RECORDER
; =====================================================

Func PollRecorder()

    If Not $recording Then
        _HideRecorderTooltip()
        Return
    EndIf
    If $running Then Return
    If $gRecordPaused Then
        RecordManualFocusTick()
        GUICtrlSetData($status, "RecPause")
        _HideRecorderTooltip()
        Return
    EndIf

    If $gRecordManualFocusWait Then
        RecordManualFocusTick()
        _HideRecorderTooltip()
        Return
    EndIf

    _UpdateRecorderTooltip()
    PollMouse()
    PollKeys()

EndFunc

; =====================================================
; POLL MOUSE
; Records left / right / middle click.
; Middle click uses C:
; M_P1,x,y,C,1,,rem_wheel
; =====================================================

Func PollMouse()

    Local $leftDown = _IsPressed("01")
    Local $rightDown = _IsPressed("02")
    Local $middleDown = _IsPressed("04")

    Local $nowDown = False
    Local $btn = ""

    If $leftDown Then
        $nowDown = True
        $btn = "L"
    ElseIf $rightDown Then
        $nowDown = True
        $btn = "R"
    ElseIf $middleDown Then
        $nowDown = True
        $btn = "C"
    EndIf

    If $nowDown And Not $mouseWasDown Then

        Local $downPos = MouseGetPos()

        $mouseButton = $btn
        $mouseDownInUI = _MouseInsideRecorderUI()
        $mouseDownX = $downPos[0]
        $mouseDownY = $downPos[1]
        $mouseDownTimer = TimerInit()
        $mouseLongPressActive = False
        $mouseWasDown = True

        Return

    EndIf

    If $nowDown And $mouseWasDown And Not $mouseDownInUI And Not $mouseLongPressActive Then

        Local $holdSec = Number(IniRead($iniFile, "Record", "mouse_down_hold_sec", "1"))
        If $holdSec < 0.1 Then $holdSec = 1

        If TimerDiff($mouseDownTimer) >= ($holdSec * 1000) Then
            Local $holdPos = MouseGetPos()
            Local $holdDragPx = Number(IniRead($iniFile, "Record", "drag_px", "5"))
            If $holdDragPx < 1 Then $holdDragPx = 5

            If Abs($holdPos[0] - $mouseDownX) <= $holdDragPx _
                And Abs($holdPos[1] - $mouseDownY) <= $holdDragPx Then

                _RecordMouseDown($mouseDownX, $mouseDownY, $mouseButton)
                $mouseLongPressActive = True
            EndIf
        EndIf

        Return

    EndIf

    If Not $nowDown And $mouseWasDown Then

        If $mouseLongPressActive Then

            Local $upLongPos = MouseGetPos()
            Local $holdDelay = Round(TimerDiff($mouseDownTimer) / 1000, 2)
            _UpdateMouseDownDelay($holdDelay)
            _RecordMouseUp($upLongPos[0], $upLongPos[1], $mouseButton)

        ElseIf Not $mouseDownInUI And Not _MouseInsideRecorderUI() Then

            Local $upPos = MouseGetPos()
            Local $dragPx = Number(IniRead($iniFile, "Record", "drag_px", "5"))
            If $dragPx < 1 Then $dragPx = 5

            If (Abs($upPos[0] - $mouseDownX) > $dragPx _
                Or Abs($upPos[1] - $mouseDownY) > $dragPx) Then

                _RecordMouseDrag($mouseDownX, $mouseDownY, $upPos[0], $upPos[1], $mouseButton)
            Else
                _RecordMouseClick($mouseDownX, $mouseDownY, $mouseButton)
            EndIf

        EndIf

        $mouseWasDown = False
        $mouseButton = ""
        $mouseDownInUI = False
        $mouseDownX = 0
        $mouseDownY = 0
        $mouseLongPressActive = False

        Return

    EndIf

EndFunc

; =====================================================
; POLL KEYBOARD
; Records key-down events once.
; UI typing is ignored.
; String text should use the configured string_toggle hotkey.
; =====================================================

Func PollKeys()

    If WinActive($gui) Then Return
    If $gReviewGui <> 0 And WinActive($gReviewGui) Then Return

    Local $ctrl = _IsPressed("11")
    Local $alt = _IsPressed("12")
    Local $shift = _IsPressed("10")
    Local $win = _IsPressed("5B") Or _IsPressed("5C")

    For $i = 1 To $keyTotal

        Local $down = _IsPressed($keyCode[$i])

        If $down And Not $keyDown[$i] Then

            Local $sendKey = _BuildAutoItKey($keyName[$i], $ctrl, $alt, $shift, $win)

            If Not _IsRecorderControlKey($sendKey) Then

                If $gStringMode Then
                    If _CanBufferStringKey($sendKey) Then
                        _BufferStringKey($sendKey)
                    Else
                        _CommitStringMode()
                        _RecordButtonKey($sendKey)
                    EndIf
                Else
                    _RecordButtonKey($sendKey)
                EndIf

            EndIf

            $keyDown[$i] = True

        ElseIf Not $down And $keyDown[$i] Then

            $keyDown[$i] = False

        EndIf

    Next

EndFunc

Func _RecordButtonKey($sendKey)

    $keyCount += 1

    Local $gap = TimerDiff($gLastKeyTimer) / 1000
    $gLastKeyTimer = TimerInit()

    Local $line = _
        "K_B" & _
        $keyCount & "," & _
        $sendKey & _
        ",1," & _
        _FormatSeconds($gap) & _
        ",rem_key"

    AppendCommand($line)

EndFunc

Func _FormatSeconds($seconds)

    If $seconds < 0 Then $seconds = 0
    If $seconds > 999 Then $seconds = 999

    Return StringFormat("%.2f", $seconds)

EndFunc

Func _BufferStringKey($sendKey)

    Switch $sendKey
        Case "{BACKSPACE}"
            If StringLen($gStringBuffer) > 0 Then
                $gStringBuffer = StringTrimRight($gStringBuffer, 1)
            EndIf
            Return
        Case "{SPACE}"
            $gStringBuffer &= " "
            Return
        Case "{ASC 034}"
            $gStringBuffer &= '"'
            Return
        Case "{ASC 044}"
            $gStringBuffer &= ","
            Return
        Case "{+}"
            $gStringBuffer &= "+"
            Return
        Case "{#}"
            $gStringBuffer &= "#"
            Return
        Case "{^}"
            $gStringBuffer &= "^"
            Return
    EndSwitch

    If StringLen($sendKey) = 1 Then
        $gStringBuffer &= $sendKey
    EndIf

EndFunc

Func _CanBufferStringKey($sendKey)

    Switch $sendKey
        Case "{BACKSPACE}", "{SPACE}", "{ASC 034}", "{ASC 044}", "{+}", "{#}", "{^}"
            Return True
    EndSwitch

    If StringLen($sendKey) = 1 Then Return True

    Return False

EndFunc

; =====================================================
; BUILD AUTOIT SEND GRAMMAR
;
; c          -> c
; Ctrl+c     -> ^c
; Alt+c      -> !c
; Ctrl+Alt+i -> ^!i
; Win+Left   -> #{LEFT}
; Shift+Tab  -> +{TAB}
; Shift+.    -> +.
; Shift+/    -> +/
; Shift+=    -> +=
; =====================================================

Func _BuildAutoItKey($key, $ctrl, $alt, $shift, $win)

    ; =====================================================
    ; Rule:
    ; 1. If Ctrl / Alt / Win is pressed, keep AutoIt modifier grammar.
    ;    Example: Ctrl+C -> ^c
    ;
    ; 2. If ONLY Shift is pressed and it creates a visible character,
    ;    record the actual visible character.
    ;    Example: Shift+/ -> ?
    ;
    ; 3. Some literal characters must be escaped because AutoIt Send()
    ;    treats them specially or our comma-separated command format
    ;    would break.
    ; =====================================================

    If $shift And Not $ctrl And Not $alt And Not $win Then

        ; A-Z
        If StringLen($key) = 1 Then

            Local $asc = Asc($key)

            If $asc >= Asc("a") And $asc <= Asc("z") Then
                Return StringUpper($key)
            EndIf

        EndIf

        ; US keyboard shifted symbols
        Switch $key

            Case "1"
                Return "!"

            Case "2"
                Return "@"

            Case "3"
                Return "{#}"

            Case "4"
                Return "$"

            Case "5"
                Return "%"

            Case "6"
                Return "{^}"

            Case "7"
                Return "&"

            Case "8"
                Return "*"

            Case "9"
                Return "("

            Case "0"
                Return ")"

            Case "-"
                Return "_"

            Case "="
                Return "{+}"

            Case "["
                Return "{"

            Case "]"
                Return "}"

            Case "\"
                Return "|"

            Case ";"
                Return ":"

            Case "'"
                Return "{ASC 034}" ; double quote

            Case ","
                Return "<"

            Case "."
                Return ">"

            Case "/"
                Return "?"

            Case "`"
                Return "~"

        EndSwitch

    EndIf

    ; =====================================================
    ; Literal non-shift comma must not break CSV command format
    ; =====================================================

    If Not $ctrl And Not $alt And Not $shift And Not $win Then

        Switch $key

            Case ","
                Return "{ASC 044}"

            Case "+"
                Return "{+}"

            Case "^"
                Return "{^}"

            Case "#"
                Return "{#}"

        EndSwitch

    EndIf

    ; =====================================================
    ; Real hotkey / modifier case
    ; =====================================================

    Local $prefix = ""

    If $ctrl Then $prefix &= "^"
    If $alt Then $prefix &= "!"
    If $shift Then $prefix &= "+"
    If $win Then $prefix &= "#"

    Return $prefix & $key

EndFunc

; =====================================================
; AVOID RECORDING RECORDER CONTROL HOTKEYS
; =====================================================

Func _IsRecorderControlKey($sendKey)

    If _MatchesConfiguredHotkey($sendKey, "emergency_stop", "+{F9}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "record_off", "!{F9}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "playback_pause", "{F9}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "manual_focus_resume", "^{F9}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "start_stop", "") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_active", "{F6}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_active_next", "+{F6}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "active_line_prev", "{F5}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "active_line_next", "{F7}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "file_prev", "!{F5}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "file_next", "!{F7}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_current_file", "!{F6}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_1", "^!1") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_2", "^!2") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_3", "^!3") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_4", "^!4") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_5", "^!5") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_6", "^!6") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_7", "^!7") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_8", "^!8") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_9", "^!9") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "run_file_0", "^!0") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "string_toggle", "^+t") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "offset_toggle", "{F8}") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "tooltip_toggle", "^+y") Then Return True
    If _MatchesConfiguredHotkey($sendKey, "mouse_move", "+{F8}") Then Return True

    Return False

EndFunc

Func _MatchesConfiguredHotkey($sendKey, $keyName, $default)

    Local $hotkey = StringStripWS(IniRead($iniFile, "Hotkeys", $keyName, $default), 3)
    If $hotkey = "" Then Return False

    Return StringLower($sendKey) = StringLower($hotkey)

EndFunc

