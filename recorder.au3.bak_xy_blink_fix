EndFunc

; =====================================================
; GET CURRENT RECORD FILE BASE NAME
; Example:
; C:\...\rec_20260520_123456.rec
; -> rec_20260520_123456
; =====================================================

Func _GetCurrentRecordBaseName()

    Local $name = $currentFile

    Local $p = StringInStr($name, "\", 0, -1)

    If $p > 0 Then
        $name = StringTrimLeft($name, $p)
    EndIf

    If StringRight($name, 4) = ".rec" Then
        $name = StringTrimRight($name, 4)
    EndIf

    Return $name

EndFunc

; =====================================================
; APPLY AUTO COMMENT TO CURRENT ACTIVE MOUSE LINE
;
; TEMP DEBUG LABEL FORMAT:
; recFileBase_0001_yymmdd_hhmm_left_top_right_bottom
;
; Example:
; rem_rec_20260520_153800_0001_260520_1542_490_280_509_319
;
; This is temporary for checking crop window.
; After crop verified, we can return to:
; rem_rec_20260520_153800_0001
; =====================================================

Func _ApplyAutoCommentToActiveMouseLine($x, $y)

    If $gActiveIndex < 1 Then Return
    If $gActiveIndex > UBound($gCurrLines) - 1 Then Return

    Local $line = $gCurrLines[$gActiveIndex]
    Local $p = StringSplit($line, ",")

    If $p[0] < 4 Then Return

    ; only apply to mouse-related commands
    If StringLeft($p[1], 2) <> "M_" And StringLeft($p[1], 4) <> "MSP_" And StringLeft($p[1], 4) <> "MSM_" And StringLeft($p[1], 3) <> "MM_" Then Return

    ; calculate exact crop rectangle first
    Local $rect = _GetMouseCropRect($x, $y)

    Local $left = $rect[0]
    Local $top = $rect[1]
    Local $right = $rect[2]
    Local $bottom = $rect[3]

    ; order number
    Local $order = StringFormat("%04i", $gAutoCommentIndex)
    $gAutoCommentIndex += 1

    Local $label = _BuildIndexCropLabel($order, $x, $y, $left, $top, $right, $bottom)

    Local $newLine = _ReplaceRemField($line, "rem_" & $label)

    $gCurrLines[$gActiveIndex] = $newLine
    $gLastVisibleText = $newLine

    _RenderCommands($gActiveIndex)

    Local $file = $appPath & "\index\" & $label & ".png"

    _HideRecorderTooltip()
    Sleep(20)
    _CaptureCropRect($file, $left, $top, $right, $bottom)
    Review_ShowLatestIndex($file)

EndFunc

Func _ApplyAutoCommentToActiveMouseLineRegion($x1, $y1, $x2, $y2)

    If $gActiveIndex < 1 Then Return
    If $gActiveIndex > UBound($gCurrLines) - 1 Then Return

    Local $line = $gCurrLines[$gActiveIndex]
    Local $p = StringSplit($line, ",")

    If $p[0] < 4 Then Return
    If StringLeft($p[1], 4) <> "MSM_" And StringLeft($p[1], 7) <> "Anchor_" Then Return

    Local $rect = _GetDragCropRect($x1, $y1, $x2, $y2)

    Local $left = $rect[0]
    Local $top = $rect[1]
    Local $right = $rect[2]
    Local $bottom = $rect[3]

    Local $order = StringFormat("%04i", $gAutoCommentIndex)
    $gAutoCommentIndex += 1

    Local $label = _BuildIndexCropLabel($order, $x1, $y1, $left, $top, $right, $bottom)
    Local $newLine = _ReplaceRemField($line, "rem_" & $label)

    $gCurrLines[$gActiveIndex] = $newLine
    $gLastVisibleText = $newLine

    _RenderCommands($gActiveIndex)

    Local $file = $appPath & "\index\" & $label & ".png"

    _HideRecorderTooltip()
    Sleep(20)
    _CaptureCropRect($file, $left, $top, $right, $bottom)
    Review_ShowLatestIndex($file)

EndFunc

; =====================================================
; APPLY AUTO COMMENT TO CURRENT ACTIVE DRAG LINE
;
; Drag auto comment creates:
; index\label.png  = small passive crop at drag top-right corner
; export\label.png = active crop of the dragged screen area
; =====================================================

Func _ApplyAutoCommentToActiveDragLine($x1, $y1, $x2, $y2)

    If $gActiveIndex < 1 Then Return
    If $gActiveIndex > UBound($gCurrLines) - 1 Then Return

    Local $line = $gCurrLines[$gActiveIndex]
    Local $p = StringSplit($line, ",")

    If $p[0] < 4 Then Return
    If StringLeft($p[1], 3) <> "MD_" Then Return

    Local $dragRect = _GetDragCropRect($x1, $y1, $x2, $y2)

    Local $dragLeft = $dragRect[0]
    Local $dragTop = $dragRect[1]
    Local $dragRight = $dragRect[2]
    Local $dragBottom = $dragRect[3]

    Local $cornerRect = _GetMouseCropRect($dragRight, $dragTop)

    Local $left = $cornerRect[0]
    Local $top = $cornerRect[1]
    Local $right = $cornerRect[2]
    Local $bottom = $cornerRect[3]

    Local $order = StringFormat("%04i", $gAutoCommentIndex)
    $gAutoCommentIndex += 1

    Local $label = _BuildIndexCropLabel($order, $x1, $y1, $left, $top, $right, $bottom)

    Local $newLine = _ReplaceRemField($line, "rem_" & $label)

    $gCurrLines[$gActiveIndex] = $newLine
    $gLastVisibleText = $newLine

    _RenderCommands($gActiveIndex)

    Local $indexFile = $appPath & "\index\" & $label & ".png"
    Local $exportFile = $appPath & "\export\" & $label & ".png"

    _HideRecorderTooltip()
    Sleep(20)
    _CaptureCropRect($indexFile, $left, $top, $right, $bottom)
    _CaptureCropRect($exportFile, $dragLeft, $dragTop, $dragRight, $dragBottom)
    Review_ShowLatestIndex($indexFile)

EndFunc

Func _BuildIndexCropLabel($order, $anchorX, $anchorY, $left, $top, $right, $bottom)

    Local $dx1 = $left - $anchorX
    Local $dx2 = $right - $anchorX
    Local $dy1 = $top - $anchorY
    Local $dy2 = $bottom - $anchorY

    Return _
        "idx_" & _
        StringRight(@YEAR, 2) & _
        @MON & _
        @MDAY & _
        "_" & _
        @HOUR & _
        @MIN & _
        @SEC & _
        "_" & _
        $order & _
        "_x" & _
        $dx1 & _
        "~" & _
        $dx2 & _
        "_y" & _
        $dy1 & _
        "~" & _
        $dy2

EndFunc

