Func _GetMouseCropRect($x, $y)

    Local $w = Number(IniRead($iniFile, "AutoComment", "crop_w", "20"))
    Local $h = Number(IniRead($iniFile, "AutoComment", "crop_h", "40"))

    If $w < 2 Then $w = 20
    If $h < 2 Then $h = 40

    Local $left = $x - Int($w / 2)
    Local $top = $y - Int($h / 2)

    If $left < 0 Then $left = 0
    If $top < 0 Then $top = 0

    If $left + $w > @DesktopWidth Then
        $left = @DesktopWidth - $w
    EndIf

    If $top + $h > @DesktopHeight Then
        $top = @DesktopHeight - $h
    EndIf

    If $left < 0 Then $left = 0
    If $top < 0 Then $top = 0

    Local $right = $left + $w - 1
    Local $bottom = $top + $h - 1

    Local $rect[4]

    $rect[0] = $left
    $rect[1] = $top
    $rect[2] = $right
    $rect[3] = $bottom

    Return $rect

EndFunc

Func _GetDragCropRect($x1, $y1, $x2, $y2)

    Local $left = $x1
    Local $right = $x2
    If $left > $right Then
        $left = $x2
        $right = $x1
    EndIf

    Local $top = $y1
    Local $bottom = $y2
    If $top > $bottom Then
        $top = $y2
        $bottom = $y1
    EndIf

    Local $minW = Number(IniRead($iniFile, "AutoComment", "crop_w", "20"))
    Local $minH = Number(IniRead($iniFile, "AutoComment", "crop_h", "40"))

    If $minW < 2 Then $minW = 20
    If $minH < 2 Then $minH = 40

    Local $w = $right - $left + 1
    Local $h = $bottom - $top + 1

    If $w < $minW Then
        Local $centerX = Int(($left + $right) / 2)
        $left = $centerX - Int($minW / 2)
        $right = $left + $minW - 1
    EndIf

    If $h < $minH Then
        Local $centerY = Int(($top + $bottom) / 2)
        $top = $centerY - Int($minH / 2)
        $bottom = $top + $minH - 1
    EndIf

    If $left < 0 Then
        $right -= $left
        $left = 0
    EndIf

    If $top < 0 Then
        $bottom -= $top
        $top = 0
    EndIf

    If $right >= @DesktopWidth Then
        Local $shiftX = $right - @DesktopWidth + 1
        $left -= $shiftX
        $right -= $shiftX
    EndIf

    If $bottom >= @DesktopHeight Then
        Local $shiftY = $bottom - @DesktopHeight + 1
        $top -= $shiftY
        $bottom -= $shiftY
    EndIf

    If $left < 0 Then $left = 0
    If $top < 0 Then $top = 0
    If $right >= @DesktopWidth Then $right = @DesktopWidth - 1
    If $bottom >= @DesktopHeight Then $bottom = @DesktopHeight - 1

    Local $rect[4]

    $rect[0] = $left
    $rect[1] = $top
    $rect[2] = $right
    $rect[3] = $bottom

    Return $rect

EndFunc

